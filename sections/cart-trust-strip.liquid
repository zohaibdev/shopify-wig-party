{%- comment -%} Search page with no results: the empty state stands alone, render nothing. Other templates are not affected. {%- endcomment -%}
{%- unless template.name == 'search' and search.performed and search.results_count == 0 -%}
{{ 'section-cart-trust-strip.css' | asset_url | stylesheet_tag }}

<section class="wp-trust-strip{% if section.settings.custom_class != blank %} {{ section.settings.custom_class }}{% endif %}" style="--wp-trust-bg: {{ section.settings.background_color }};">
  <div class="wp-trust-strip__inner">
    {%- for block in section.blocks -%}
      {%- liquid
        assign default_icon = 'cart-trust-returns-icon.svg'
        assign default_icon_mobile = 'cart-trust-returns-icon-mobile.svg'
        if block.settings.default_icon == 'consult'
          assign default_icon = 'cart-trust-consult-icon.svg'
          assign default_icon_mobile = 'cart-trust-consult-icon-mobile.svg'
        elsif block.settings.default_icon == 'colour-ring'
          assign default_icon = 'cart-trust-colour-ring-icon.svg'
          assign default_icon_mobile = 'cart-trust-colour-ring-icon-mobile.svg'
        elsif block.settings.default_icon == 'live'
          assign default_icon = 'wp-trust-wear-share.svg'
          assign default_icon_mobile = 'wp-trust-wear-share.svg'
        elsif block.settings.default_icon == 'shipping'
          assign default_icon = 'wp-trust-free-shipping.svg'
          assign default_icon_mobile = 'wp-trust-free-shipping.svg'
        elsif block.settings.default_icon == 'packaging'
          assign default_icon = 'cart-trust-packaging-icon.svg'
          assign default_icon_mobile = 'cart-trust-packaging-icon-mobile.svg'
        endif
        if block.settings.link != blank
          assign tag = 'a'
        else
          assign tag = 'div'
        endif
      -%}
      <{{ tag }} class="wp-trust-strip__item{% if block.settings.content_width %} wp-trust-strip__item--auto{% endif %}" {% if tag == 'a' %}href="{{ block.settings.link }}"{% endif %} {{ block.shopify_attributes }}>
        {%- if block.settings.icon != blank -%}
          {{ block.settings.icon | image_url: width: 128 | image_tag: class: 'wp-trust-strip__icon', width: 64, height: 64, alt: block.settings.heading, loading: 'lazy' }}
        {%- else -%}
          <picture>
            <source media="(max-width: 749px)" srcset="{{ default_icon_mobile | asset_url }}">
            <img class="wp-trust-strip__icon" src="{{ default_icon | asset_url }}" alt="" width="64" height="64" loading="lazy">
          </picture>
        {%- endif -%}
        <div class="wp-trust-strip__text">
          {%- if block.settings.heading != blank -%}
            <p class="wp-trust-strip__heading">{{ block.settings.heading }}</p>
          {%- endif -%}
          {%- if block.settings.description != blank -%}
            <p class="wp-trust-strip__description">{{ block.settings.description | escape | newline_to_br }}</p>
          {%- endif -%}
        </div>
      </{{ tag }}>
    {%- endfor -%}
  </div>
</section>
{%- endunless -%}

{% schema %}
{
  "name": "Trust strip",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#ffffff" },
    { "type": "text", "id": "custom_class", "label": "Custom CSS class (optional)", "info": "Adds an extra class to this section instance for page-specific style overrides. Leave blank to use the shared defaults." }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust item",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon (optional, overrides default)", "info": "Recommended 64 x 64 SVG or PNG." },
        { "type": "select", "id": "default_icon", "label": "Default icon", "default": "returns", "options": [
          { "value": "returns", "label": "Returns" },
          { "value": "consult", "label": "Consult" },
          { "value": "colour-ring", "label": "Colour ring" },
          { "value": "packaging", "label": "Packaging" },
          { "value": "live", "label": "Live try-on" },
          { "value": "shipping", "label": "Shipping" }
        ] },
        { "type": "text", "id": "heading", "label": "Heading", "default": "All sales final, ask us first" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "url", "id": "link", "label": "Link (optional)" },
        { "type": "checkbox", "id": "content_width", "label": "Content width (instead of fixed 255px)", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust strip",
      "blocks": [
        { "type": "trust_item", "settings": { "default_icon": "live", "heading": "Tried on Live by Kristi", "description": "Text love to (833) 280-2725 for live alerts.", "content_width": true } },
        { "type": "trust_item", "settings": { "default_icon": "packaging", "heading": "Processed in 1 to 3 business days", "content_width": true } },
        { "type": "trust_item", "settings": { "default_icon": "shipping", "heading": "Tracking within 24 to 48 hours", "content_width": true } },
        { "type": "trust_item", "settings": { "default_icon": "consult", "heading": "All sales final, ask us first", "description": "Email shopwigparty@gmail.com before you order.", "content_width": true } }
      ]
    }
  ]
}
{% endschema %}
