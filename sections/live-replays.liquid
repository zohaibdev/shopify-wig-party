{%- comment -%}
  Wig Party — Watch Live, "Recent replays". Figma internal file, node 6849:21380 (1440 x 864).

  A left-aligned heading and a row of the latest `count` replays from LiveMeUp: cover,
  date, show title and a WATCH & SHOP button that opens LiveMeUp's shoppable player; then a
  centred THE WHOLE LIBRARY button. Nothing about a replay is set here — they all come
  from the LiveMeUp app (assets/aria-livemeup.js). Mobile (Figma 6849:21874) is two
  columns; see the max-width 749px block. Styles in assets/section-aria-live-replays.css.
{%- endcomment -%}

{{ 'section-aria-live-replays.css' | asset_url | stylesheet_tag }}
{%- render 'aria-livemeup' -%}

<div class="aria-live-replays" style="--aria-live-replays-bg: {{ section.settings.background_color }};" data-lmu-root>
  <div class="aria-live-replays__inner">
  {%- if section.settings.heading != blank -%}
    <h2 class="aria-live-replays__title">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div data-lmu-list data-lmu-source="replays" data-lmu-limit="{{ section.settings.count }}">
    <template data-lmu-template>
      <li class="aria-live-replays__card">
        <a class="aria-live-replays__media" href="#" data-lmu-href data-lmu-play tabindex="-1" aria-hidden="true">
          <span data-lmu-cover="324"></span>
        </a>
        <div class="aria-live-replays__body">
          <div class="aria-live-replays__info">
            <div class="aria-live-replays__meta">
              <p class="aria-live-replays__date" data-lmu-date="meta"></p>
              <h3 class="aria-live-replays__name" data-lmu-title></h3>
            </div>
          </div>
          {%- if section.settings.card_button_label != blank -%}
            <a class="aria-live-replays__button" href="#" data-lmu-href data-lmu-play>{{ section.settings.card_button_label }}</a>
          {%- endif -%}
        </div>
      </li>
    </template>

    <ul class="aria-live-replays__cards" role="list" data-lmu-items>
      {%- for i in (1..section.settings.count) -%}
        <li class="aria-live-replays__card" data-lmu-loading aria-hidden="true">
          <span class="aria-live-replays__media aria-lmu-skeleton"></span>
          <span class="aria-lmu-skeleton-line"></span>
          <span class="aria-lmu-skeleton-line aria-lmu-skeleton-line--short"></span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
  <p data-lmu-empty>{{ section.settings.empty_text }}</p>
  <p data-lmu-error>{{ 'aria_theme.live.lmu.unavailable' | t }}</p>

  {%- if section.settings.button_label != blank -%}
    <div class="aria-live-replays__actions" data-lmu-hide-empty>
      <a class="aria-live-replays__more" href="{{ section.settings.button_url | default: '/pages/replays' }}">
        {{- section.settings.button_label -}}
      </a>
    </div>
  {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.aria-live-replays.name",
  "tag": "section",
  "class": "aria-live-replays-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.aria-live-replays.settings.source.content"
    },
    {
      "type": "color_background",
      "id": "background_color",
      "default": "#F5EBE2",
      "label": "t:sections.aria-live-replays.settings.background_color.label"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Recent replays",
      "label": "t:sections.aria-live-replays.settings.heading.label"
    },
    {
      "type": "range",
      "id": "count",
      "min": 2,
      "max": 8,
      "step": 2,
      "default": 4,
      "label": "t:sections.aria-live-replays.settings.count.label"
    },
    {
      "type": "text",
      "id": "card_button_label",
      "default": "Watch & shop",
      "label": "t:sections.aria-live-replays.settings.card_button_label.label"
    },
    {
      "type": "text",
      "id": "empty_text",
      "default": "No replays yet. The first one appears here as soon as a show ends.",
      "label": "t:sections.aria-live-replays.settings.empty_text.label"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "The whole library",
      "label": "t:sections.aria-live-replays.settings.button_label.label"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "t:sections.aria-live-replays.settings.button_url.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.aria-live-replays.presets.name"
    }
  ]
}
{% endschema %}
