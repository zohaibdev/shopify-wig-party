{{ 'design-tokens.css' | asset_url | stylesheet_tag }}
{{ 'section-wp-search-collections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'wp-search-collections.js' | asset_url }}" defer="defer"></script>

{%- if predictive_search.performed -%}
  {%- assign collections = predictive_search.resources.collections -%}
  {%- if collections.size > 0 -%}
    <div
      class="wp-collections"
      data-wp-collections
      data-wp-collections-mode="cards"
      style="--wp-collections-pad-top: {{ section.settings.padding_top }}px;"
    >
      <div class="wp-collections__inner" data-wp-collections-content>
        <h2 class="wp-collections__title">{{ section.settings.heading | escape }}</h2>
        <ul class="wp-collections__grid">
          {%- for collection in collections limit: 2 -%}
            {%- liquid
              assign short_name = collection.title | split: ' — ' | first | strip
              if short_name == blank
                assign short_name = collection.title
              endif

              assign link_text = collection.metafields.custom.cta_label.value
              if link_text == blank
                assign link_text = section.settings.link_template | replace: '{name}', short_name
              endif

              assign blurb = collection.metafields.custom.search_blurb.value
              if blurb == blank
                assign blurb = collection.description | strip_html | strip | truncate: 120
              endif

              assign count_text = section.settings.count_template | replace: '{count}', collection.products_count
              assign sub_text = count_text
              if blurb != blank
                assign sub_text = count_text | append: ' ' | append: blurb
              endif
            -%}
            <li class="wp-collections__card">
              <div class="wp-collections__thumb">
                {%- comment -%} Nov 6: most collection images are text graphics, so the first product photo wins. {%- endcomment -%}
                {%- assign thumb_image = collection.products.first.featured_image | default: collection.image -%}
                {%- if thumb_image != blank -%}
                  {{ thumb_image | image_url: width: 244 | image_tag: loading: 'lazy', widths: '122, 244', sizes: '122px', alt: collection.title }}
                {%- endif -%}
              </div>
              <div class="wp-collections__body">
                <div class="wp-collections__text">
                  <h3 class="wp-collections__card-title">{{ collection.title | escape }}</h3>
                  {%- if sub_text != blank -%}
                    <p class="wp-collections__sub">{{ sub_text | escape }}</p>
                  {%- endif -%}
                </div>
                <a class="wp-collections__link" href="{{ collection.url }}">{{ link_text | escape }}</a>
              </div>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  {%- endif -%}
{%- elsif search.performed and search.results_count == 0 -%}
  {%- comment -%} No products found: the empty state replaces this section, so no shell and no fetch. {%- endcomment -%}
{%- else -%}
  {%- comment -%} Page request: empty hidden shell. wp-search-collections.js fetches predictive search and injects the cards. {%- endcomment -%}
  <div
    class="wp-collections"
    data-wp-collections
    data-wp-collections-mode="shell"
    data-wp-collections-terms="{{ search.terms | url_encode }}"
    data-wp-collections-section-id="{{ section.id }}"
    data-wp-collections-url="{{ routes.predictive_search_url }}"
    hidden
  ></div>
{%- endif -%}

{% schema %}
{
  "name": "Search collections",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "COLLECTIONS"
    },
    {
      "type": "text",
      "id": "count_template",
      "label": "Product count text",
      "info": "Use {count}. Shown before the collection blurb.",
      "default": "{count} styles."
    },
    {
      "type": "text",
      "id": "link_template",
      "label": "Link text",
      "info": "Use {name} (title before ' — '). Metafield custom.cta_label overrides.",
      "default": "Shop {name} →"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
