{{ 'section-aria-why-wig-party.css' | asset_url | stylesheet_tag }}
<script src="{{ 'aria-why-wig-party.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign has_video = false
  if section.settings.video != blank or section.settings.video_url != blank
    assign has_video = true
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .aria-why {
    --aria-why-bg: {{ section.settings.background_color }};
    --aria-why-frame-border: {{ section.settings.frame_border_color }};
  }

  /*
   * Hosted-video toggle (sections/why-wig-party.liquid, assets/aria-why-wig-party.js).
   * Kept here rather than in assets/section-aria-why-wig-party.css, since that file's
   * "aria-*" naming is ambiguous with the theme's shared aria-*.css files and this block
   * is new, section-owned behaviour rather than the V4 layout rules already there.
   *
   * One button spans the whole frame (class aria-why__poster, styles already defined in
   * section-aria-why-wig-party.css) and never leaves the DOM; only its contents fade here,
   * driven by the native-event-driven data-state the script sets, so the button itself
   * stays the click target for pausing even while "invisible".
   */
  #shopify-section-{{ section.id }} .aria-why__video-toggle[data-state='playing'] .aria-why__image,
  #shopify-section-{{ section.id }} .aria-why__video-toggle[data-state='playing'] .aria-why__scrim,
  #shopify-section-{{ section.id }} .aria-why__video-toggle[data-state='playing'] .aria-why__play {
    opacity: 0;
  }

  /* section-aria-why-wig-party.css (not edited for this) still carries an older rule,
     `.aria-why__media--video .aria-why__play { display: none; }`, written back when a
     hosted video always autoplayed and the centre glyph was never shown over it. It would
     otherwise hide the play glyph outright, in every state, overriding the opacity rule
     above. This restores it only while paused, higher-specificity so it wins without
     touching that file. */
  #shopify-section-{{ section.id }} .aria-why__media--video .aria-why__video-toggle[data-state='paused'] .aria-why__play {
    display: block;
  }

  /* Figma (node 7238:4842) has no corner play/pause or mute button on this frame — only
     the one centred glyph above. The shared .aria-video-ctrl markup is not rendered by this
     section any more, but this stays as a defensive, scoped hide in case a future edit ever
     reintroduces it here by mistake. assets/aria-video-controls.js,
     assets/component-aria-video-controls.css and snippets/aria-icon.liquid are shared with
     Real Customers and are not edited for this. */
  #shopify-section-{{ section.id }} .aria-video-ctrl {
    display: none !important;
  }

  /*
   * Playing-state corner controls (mute + pause), scoped here rather than in
   * assets/section-aria-why-wig-party.css since that file is shared V4-layout CSS and
   * this is new, section-owned behaviour. Deliberately separate class names
   * (aria-why__ctrl*) from the shared .aria-video-ctrl so the defensive hide above can
   * never catch these. Sized and positioned per the Figma-less fallback: the old shared
   * corner-button treatment (assets/component-aria-video-controls.css, 40px desktop
   * discs) adapted to this frame, since no node for this control pair exists in the
   * inspected Figma frame (node 7238:4842 has no corner controls at all).
   *
   * No z-index anywhere else in .aria-why__media's stacking (section-aria-why-wig-party.css
   * never sets one), so these simply need to come after .aria-why__video-toggle in the
   * markup to paint above it -- which they do.
   */
  #shopify-section-{{ section.id }} .aria-why__ctrl {
    position: absolute;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 50%;
    background: rgba(20, 20, 20, 0.42);
    color: var(--white, #fff);
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    visibility: hidden;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  /* Shown only while playing, and only via visibility -- never display -- so they can
     never be the thing that breaks the toggle's own hit area underneath. Keyed off
     data-aria-why-media's data-state, set in assets/aria-why-wig-party.js from the
     video's native play/pause/ended events. */
  #shopify-section-{{ section.id }} [data-aria-why-media][data-state='playing'] .aria-why__ctrl {
    visibility: visible;
  }

  #shopify-section-{{ section.id }} .aria-why__ctrl--mute {
    top: 16px;
    right: 16px;
  }

  #shopify-section-{{ section.id }} .aria-why__ctrl--pause {
    bottom: 16px;
    left: 16px;
  }

  @media (hover: hover) and (pointer: fine) {
    #shopify-section-{{ section.id }} .aria-why__ctrl:hover {
      background: rgba(20, 20, 20, 0.62);
      border-color: rgba(255, 255, 255, 0.5);
    }
  }

  #shopify-section-{{ section.id }} .aria-why__ctrl:focus-visible {
    outline: 2px solid var(--white, #fff);
    outline-offset: -4px;
    box-shadow: none;
  }

  #shopify-section-{{ section.id }} .aria-why__ctrl-icon {
    display: block;
    width: 14px;
    height: 14px;
  }

  /* One icon per mute state, so the toggle is an attribute flip rather than an
     innerHTML rewrite -- same technique assets/component-aria-video-controls.css uses
     for its own sound button, not shared code. */
  #shopify-section-{{ section.id }} .aria-why__ctrl--mute[data-state='muted'] .aria-why__ctrl-icon--on,
  #shopify-section-{{ section.id }} .aria-why__ctrl--mute[data-state='unmuted'] .aria-why__ctrl-icon--off {
    display: none;
  }
{%- endstyle -%}

<section class="aria-why">
  <div class="aria-why__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="aria-why__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="aria-why__column">
      {%- comment -%}
        Media frame. A merchant-selected video wins over the still image; the still
        doubles as the video poster so the frame is never empty. Mirrors the ladder in
        sections/meet-the-icons.liquid.
      {%- endcomment -%}
      {%- comment -%}
        Poster markup is shared by both branches below, so it is captured once.
      {%- endcomment -%}
      {%- capture poster_media -%}
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1692
            | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 990px) 846px, calc(100vw - 56px)',
              widths: '480,720,846,1024,1400,1692',
              class: 'aria-why__image',
              alt: section.settings.image.alt | default: section.settings.heading
          }}
        {%- else -%}
          {%- comment -%} Placeholder still from the V4 design until a merchant sets media. {%- endcomment -%}
          <img
            src="{{ 'wp-meet-the-icons-bg.jpg' | asset_url }}"
            alt=""
            width="1264"
            height="845"
            loading="lazy"
            class="aria-why__image"
          >
        {%- endif -%}

        {%- comment -%}
          V4 lays a flat rgba(0,0,0,0.2) scrim over the poster (node 1:886). It was
          skipped at first as Figma video-poster noise, but it is doing real work: the
          Kristi signature is white, and without the scrim it sits on a mid-tone part of
          the photo (measured luma 128) where it all but disappears. Rendered before the
          play glyph and the signature so both stay crisp above it. The inert child keeps
          Dawn's `:empty { display: none }` from sweeping it away.
        {%- endcomment -%}
        <span class="aria-why__scrim" aria-hidden="true"><span></span></span>
      {%- endcapture -%}

      {%- capture play_glyph -%}
        <span class="aria-why__play" aria-hidden="true">
          <img
            src="{{ 'wp-play-button.svg' | asset_url }}"
            alt=""
            width="70"
            height="70"
            loading="lazy"
          >
        </span>
      {%- endcapture -%}

      <div class="aria-why__frame">
        {%- liquid
          assign video_id = section.settings.video_url.id
          assign control_params = ''
          unless section.settings.video_show_controls
            assign control_params = '&controls=0'
          endunless

          # A Shopify-hosted file gets the autoplay + custom-controls treatment; an external
          # URL keeps the click-to-play poster below.
          assign has_hosted_video = false
          if section.settings.video != blank
            assign has_hosted_video = true
          endif
        -%}
        {%- if has_hosted_video -%}
          {%- comment -%}
            Independent of the shared assets/aria-video-controls.js on purpose (behaviour is
            in assets/aria-why-wig-party.js instead). That shared manager autoplays + mutes
            every [data-aria-video] unconditionally and owns a cross-section single-audio
            rule — neither fits here: the `video_autoplay` setting below must be able to
            turn autoplay off, and the Figma design (node 7238:4842) has no mute control at
            all, just one big centred play glyph that doubles as the poster. So this video
            carries its own data-aria-why-* attributes and gets a dedicated small script
            instead of the shared corner play/pause + mute buttons: a single full-frame
            toggle showing the thumbnail + play glyph while paused, invisible-but-clickable
            while playing, driven by the video's own native play/pause/ended/error events
            rather than the shared script's data-state.

            `controls` is deliberately absent: that absence is what keeps the native
            timeline, volume slider, fullscreen and PiP chrome off the video, and
            `playsinline` is what stops iOS going fullscreen. `autoplay`/`muted` are only
            rendered when `video_autoplay` is on — a browser only honours autoplay when
            `muted` is a real ATTRIBUTE, not merely set from JS. A manual play (the toggle
            button) always unmutes first, since that click is a real user gesture.

            Built by hand rather than with `video_tag` for the same reason as Real Customers:
            `video_tag` forces the video's own preview frame as the poster and offers no
            override, and this design wants the merchant's still image there, as both the
            poster attribute and the thumbnail shown while paused.
          {%- endcomment -%}
          {%- liquid
            assign why_poster_url = ''
            if section.settings.image != blank
              assign why_poster_url = section.settings.image | image_url: width: 1600
            elsif section.settings.video.preview_image != blank
              assign why_poster_url = section.settings.video.preview_image | image_url: width: 1600
            else
              assign why_poster_url = 'wp-meet-the-icons-bg.jpg' | asset_url
            endif
          -%}
          <div class="aria-why__media aria-why__media--video" data-aria-why-media>
            <video
              class="aria-why__video"
              data-aria-why-video
              {%- if section.settings.video_autoplay %}
                autoplay
                muted
              {%- endif %}
              loop
              playsinline
              preload="metadata"
              poster="{{ why_poster_url }}"
            >
              {%- for source in section.settings.video.sources -%}
                <source src="{{ source.url }}" type="{{ source.mime_type }}">
              {%- endfor -%}
            </video>

            {%- comment -%}
              One button spans the whole frame rather than a small corner disc — Figma shows
              a single centred glyph, not a toolbar. While paused it shows the poster_media +
              play_glyph captures above and is the click target that starts the video; while
              playing, assets/aria-why-wig-party.js flips data-state to "playing" and the
              rules added to the <style> block above fade its contents out, but the button
              itself stays in place as the click target for pausing — "video area" and "the
              button" are the same element here, and nothing outside this media box is
              clickable.
            {%- endcomment -%}
            <button
              type="button"
              class="aria-why__poster aria-why__video-toggle"
              data-aria-why-toggle
              data-state="paused"
              aria-pressed="false"
              data-label-play="{{ 'aria_theme.video.play' | t | escape }}"
              data-label-pause="{{ 'aria_theme.video.pause' | t | escape }}"
              aria-label="{{ 'aria_theme.video.play' | t }}"
            >
              {{ poster_media }}
              {{ play_glyph }}
            </button>

            {%- comment -%}
              Playing-state corner controls (mute top-right, pause bottom-left). Siblings
              of the full-frame toggle above, not nested inside it, so a click on either
              never bubbles into the toggle's own click handler and no double-fire is
              possible. Visibility (not display) is keyed off data-aria-why-media's own
              data-state, set only from this video's native play/pause/ended events in
              assets/aria-why-wig-party.js below -- never from the shared, unused-here
              assets/aria-video-controls.js data-state contract. Icons are the existing
              'pause' / 'sound-on' / 'sound-off' glyphs snippets/aria-icon.liquid already
              carries for this exact corner-button pattern (see that file's own comment);
              rendered here only, snippet itself untouched.
            {%- endcomment -%}
            <button
              type="button"
              class="aria-why__ctrl aria-why__ctrl--mute"
              data-aria-why-mute
              data-state="unmuted"
              aria-pressed="false"
              data-label-mute="{{ 'aria_theme.video.mute' | t | escape }}"
              data-label-unmute="{{ 'aria_theme.video.unmute' | t | escape }}"
              aria-label="{{ 'aria_theme.video.mute' | t }}"
            >
              {%- render 'aria-icon', name: 'sound-on', class: 'aria-why__ctrl-icon aria-why__ctrl-icon--on' -%}
              {%- render 'aria-icon', name: 'sound-off', class: 'aria-why__ctrl-icon aria-why__ctrl-icon--off' -%}
            </button>

            <button
              type="button"
              class="aria-why__ctrl aria-why__ctrl--pause"
              data-aria-why-pause
              aria-label="{{ 'aria_theme.video.pause' | t }}"
            >
              {%- render 'aria-icon', name: 'pause', class: 'aria-why__ctrl-icon' -%}
            </button>
        {%- elsif has_video -%}
          {%- comment -%}
            External URL: click-to-play via Dawn's <deferred-media> (assets/global.js). The
            custom controls cannot drive a third-party iframe without loading YouTube's or
            Vimeo's player API, and such a video cannot join the shared audio group either,
            so a hosted file is preferred here.
          {%- endcomment -%}
          <deferred-media class="aria-why__media aria-why__media--deferred">
            <button
              id="Deferred-Poster-{{ section.id }}"
              class="aria-why__poster"
              type="button"
              aria-label="{{ 'aria_theme.why_wig_party.play_video' | t }}"
            >
              {{ poster_media }}
              {{ play_glyph }}
            </button>

            <template>
                {%- comment -%}
                  Built by hand from video_url.type / .id, the way Dawn's own video.liquid
                  does it. `external_video_tag` only accepts a product media object and
                  raises "does not support VideoUrlDrop" on a video_url setting.
                {%- endcomment -%}
                {%- if section.settings.video_url.type == 'youtube' -%}
                  <iframe
                    class="aria-why__video"
                    src="https://www.youtube.com/embed/{{ video_id }}?enablejsapi=1&playsinline=1&loop=1&playlist={{ video_id }}&autoplay=1{{ control_params }}"
                    title="{{ section.settings.heading | default: 'Video' | escape }}"
                    allow="autoplay; encrypted-media; picture-in-picture"
                    allowfullscreen
                  ></iframe>
                {%- else -%}
                  <iframe
                    class="aria-why__video"
                    src="https://player.vimeo.com/video/{{ video_id }}?loop=1&playsinline=1&autoplay=1{{ control_params }}"
                    title="{{ section.settings.heading | default: 'Video' | escape }}"
                    allow="autoplay; encrypted-media; picture-in-picture"
                    allowfullscreen
                  ></iframe>
                {%- endif -%}
            </template>
        {%- else -%}
          <div class="aria-why__media">
            {{ poster_media }}
            {%- comment -%}
              No video is set, so the glyph is decorative only — it is aria-hidden and
              not a control, because a play button that cannot play anything is a lie.
              Set a video (or an external URL) and the branch above turns it into a real
              click-to-play control.
            {%- endcomment -%}
            {%- if section.settings.show_play_icon -%}
              {{ play_glyph }}
            {%- endif -%}
        {%- endif -%}

          {%- if section.settings.show_signature -%}
            <span class="aria-why__signature" aria-hidden="true">
              {%- if section.settings.signature_image != blank -%}
                {{
                  section.settings.signature_image
                  | image_url: width: 480
                  | image_tag: loading: 'lazy', widths: '160,320,480', class: 'aria-why__signature-img', alt: ''
                }}
              {%- else -%}
                <img
                  src="{{ 'wp-kristi-signature.svg' | asset_url }}"
                  alt=""
                  width="158"
                  height="62"
                  loading="lazy"
                  class="aria-why__signature-img"
                >
              {%- endif -%}
            </span>
          {%- endif -%}
        {%- comment -%} Close whichever media element the branch above opened. {%- endcomment -%}
        {%- if has_hosted_video -%}
          </div>
        {%- elsif has_video -%}
          </deferred-media>
        {%- else -%}
          </div>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <ul class="aria-why__features" role="list">
          {%- for block in section.blocks -%}
            <li class="aria-why__feature" {{ block.shopify_attributes }}>
              <span class="aria-why__badge">
                {%- if block.settings.icon != blank -%}
                  {{
                    block.settings.icon
                    | image_url: width: 56
                    | image_tag: loading: 'lazy', widths: '28,56', class: 'aria-why__badge-icon', alt: ''
                  }}
                {%- else -%}
                  <img
                    src="{{ 'wp-icon-free-shipping.svg' | asset_url }}"
                    alt=""
                    width="28"
                    height="24"
                    loading="lazy"
                    class="aria-why__badge-icon"
                  >
                {%- endif -%}
              </span>

              {%- if block.settings.label != blank -%}
                <p class="aria-why__label">{{ block.settings.label }}</p>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.aria-why-wig-party.name",
  "tag": "section",
  "class": "aria-why-wig-party-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Why Wig Party",
      "label": "t:sections.aria-why-wig-party.settings.heading.label"
    },
    {
      "type": "header",
      "content": "t:sections.aria-why-wig-party.settings.header_media.content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.aria-why-wig-party.settings.image.label",
      "info": "t:sections.aria-why-wig-party.settings.image.info"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:sections.aria-why-wig-party.settings.video.label"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube", "vimeo"],
      "label": "t:sections.aria-why-wig-party.settings.video_url.label",
      "info": "t:sections.aria-why-wig-party.settings.video_url.info"
    },
    {
      "type": "checkbox",
      "id": "video_autoplay",
      "default": false,
      "label": "t:sections.aria-why-wig-party.settings.video_autoplay.label",
      "info": "t:sections.aria-why-wig-party.settings.video_autoplay.info"
    },
    {
      "type": "checkbox",
      "id": "video_show_controls",
      "default": true,
      "label": "t:sections.aria-why-wig-party.settings.video_show_controls.label"
    },
    {
      "type": "checkbox",
      "id": "show_play_icon",
      "default": true,
      "label": "t:sections.aria-why-wig-party.settings.show_play_icon.label",
      "info": "t:sections.aria-why-wig-party.settings.show_play_icon.info"
    },
    {
      "type": "header",
      "content": "t:sections.aria-why-wig-party.settings.header_signature.content"
    },
    {
      "type": "checkbox",
      "id": "show_signature",
      "default": true,
      "label": "t:sections.aria-why-wig-party.settings.show_signature.label"
    },
    {
      "type": "image_picker",
      "id": "signature_image",
      "label": "t:sections.aria-why-wig-party.settings.signature_image.label",
      "info": "t:sections.aria-why-wig-party.settings.signature_image.info"
    },
    {
      "type": "header",
      "content": "t:sections.aria-why-wig-party.settings.header_colors.content"
    },
    {
      "type": "color",
      "id": "background_color",
      "default": "#F5EBE2",
      "label": "t:sections.aria-why-wig-party.settings.background_color.label"
    },
    {
      "type": "color",
      "id": "frame_border_color",
      "default": "#BC696B",
      "label": "t:sections.aria-why-wig-party.settings.frame_border_color.label"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "t:sections.aria-why-wig-party.blocks.feature.name",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "default": "In Stock & Ready to Ship",
          "label": "t:sections.aria-why-wig-party.blocks.feature.settings.label.label"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "t:sections.aria-why-wig-party.blocks.feature.settings.icon.label",
          "info": "t:sections.aria-why-wig-party.blocks.feature.settings.icon.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.aria-why-wig-party.presets.name",
      "blocks": [
        { "type": "feature", "settings": { "label": "Hand-Picked by Kristi" } },
        { "type": "feature", "settings": { "label": "In Stock & Ready to Ship" } },
        { "type": "feature", "settings": { "label": "Live Shopping on Facebook" } }
      ]
    }
  ]
}
{% endschema %}
