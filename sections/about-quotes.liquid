{%- comment -%}
  Wig Party — About Kristi page, quotes. Figma internal file, desktop node 7841:3565
  (1440 x 448), mobile node 7847:263 (375 x 866).
  White-to-cream ground holding `quote` blocks: an 84 icon, a label and Kristi's words,
  centred on a white card with a fading border.
  Styles in assets/section-aria-about-quotes.css.
{%- endcomment -%}

{{ 'section-aria-about-quotes.css' | asset_url | stylesheet_tag }}

{%- liquid
  # -- theme.liquid only font_faces the body regular/bold; the labels are Poppins Medium.
  assign body_font_medium = settings.type_body_font | font_modify: 'weight', '500'
-%}
{% style %}
  {%- if body_font_medium -%}{{ body_font_medium | font_face: font_display: 'swap' }}{%- endif -%}
{% endstyle %}

<div class="aria-about-quotes">
  <ul class="aria-about-quotes__cards" role="list">
    {%- for block in section.blocks -%}
      <li class="aria-about-quotes__card" {{ block.shopify_attributes }}>
        <span class="aria-about-quotes__icon">
          {%- if block.settings.icon_image != blank -%}
            {{
              block.settings.icon_image
              | image_url: width: 252
              | image_tag: width: 84, height: 84, alt: '', loading: 'lazy'
            }}
          {%- else -%}
            <img
              src="{{ 'wp-about-quote-' | append: block.settings.icon | append: '.svg' | asset_url }}"
              alt=""
              width="84"
              height="84"
              loading="lazy"
            >
          {%- endif -%}
        </span>

        <div class="aria-about-quotes__copy">
          {%- if block.settings.label != blank -%}
            <h2 class="aria-about-quotes__label">{{ block.settings.label }}</h2>
          {%- endif -%}
          {%- if block.settings.quote != blank -%}
            <p
              class="aria-about-quotes__quote"
              {% if block.settings.text_width > 0 %}
                style="--quote-width: {{ block.settings.text_width }}px;"
              {% endif %}
            >
              {%- comment -%}
                A space typed before a line break is kept (as a no-break space): Figma
                centres each line including it.
              {%- endcomment -%}
              {{- block.settings.quote | escape | newline_to_br | replace: ' <br />', '<span class="aria-about-quotes__eol">&nbsp;</span><br />' -}}
            </p>
          {%- endif -%}
        </div>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "t:sections.aria-about-quotes.name",
  "tag": "section",
  "class": "aria-about-quotes-section",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "quote",
      "name": "t:sections.aria-about-quotes.blocks.quote.name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "default": "community",
          "label": "t:sections.aria-about-quotes.blocks.quote.settings.icon.label",
          "options": [
            { "value": "community", "label": "t:sections.aria-about-quotes.blocks.quote.settings.icon.options__1.label" },
            { "value": "tag", "label": "t:sections.aria-about-quotes.blocks.quote.settings.icon.options__2.label" },
            { "value": "home", "label": "t:sections.aria-about-quotes.blocks.quote.settings.icon.options__3.label" }
          ]
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "t:sections.aria-about-quotes.blocks.quote.settings.icon_image.label",
          "info": "t:sections.aria-about-quotes.blocks.quote.settings.icon_image.info"
        },
        {
          "type": "text",
          "id": "label",
          "default": "ON COMMUNITY",
          "label": "t:sections.aria-about-quotes.blocks.quote.settings.label.label"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "t:sections.aria-about-quotes.blocks.quote.settings.quote.label",
          "info": "t:sections.aria-about-quotes.blocks.quote.settings.quote.info"
        },
        {
          "type": "number",
          "id": "text_width",
          "label": "t:sections.aria-about-quotes.blocks.quote.settings.text_width.label",
          "info": "t:sections.aria-about-quotes.blocks.quote.settings.text_width.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.aria-about-quotes.presets.name",
      "blocks": [
        { "type": "quote" },
        { "type": "quote" },
        { "type": "quote" }
      ]
    }
  ]
}
{% endschema %}
