{%- comment -%}
  Wig Party — Reviews page "Four rules". Figma 7664:18093 (1440 x 560, desktop).
  Heading + up to 4 rule cards (icon, title, text). Cards are static, not clickable.
  Blank icon = built-in default chosen in the block (assets/reviews-rules-icon-*.svg).
  Styles in assets/section-reviews-rules.css.
{%- endcomment -%}

{{ 'design-tokens.css' | asset_url | stylesheet_tag }}
{{ 'section-reviews-rules.css' | asset_url | stylesheet_tag }}

<div class="reviews-rules">
  <div class="reviews-rules__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="reviews-rules__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="reviews-rules__grid">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <div class="reviews-rules__card" {{ block.shopify_attributes }}>
            <div class="reviews-rules__icon">
              {%- if b.icon != blank -%}
                {{ b.icon | image_url: width: 168 | image_tag: width: 84, height: 84, loading: 'lazy', alt: '' }}
              {%- else -%}
                {%- assign icon_file = 'reviews-rules-icon-' | append: b.default_icon | append: '.svg' -%}
                <img src="{{ icon_file | asset_url }}" width="84" height="84" loading="lazy" alt="">
              {%- endif -%}
            </div>
            <div class="reviews-rules__copy">
              {%- if b.title != blank -%}
                <h3 class="reviews-rules__title">{{ b.title | escape }}</h3>
              {%- endif -%}
              {%- if b.text != blank -%}
                <p class="reviews-rules__text">{{ b.text | escape }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Reviews rules",
  "tag": "section",
  "class": "section-reviews-rules",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Four rules"
    }
  ],
  "blocks": [
    {
      "type": "rule",
      "name": "Rule card",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon",
          "info": "84 x 84. Blank uses the default icon below."
        },
        {
          "type": "select",
          "id": "default_icon",
          "label": "Default icon",
          "options": [
            { "value": "verified", "label": "Verified badge" },
            { "value": "critical", "label": "People" },
            { "value": "answers", "label": "Chat bubbles" },
            { "value": "photos", "label": "Photo" }
          ],
          "default": "verified"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Verified orders only"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Every review is tied to a real order. We do not accept unverified ones and we do not buy any."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews rules",
      "blocks": [
        {
          "type": "rule",
          "settings": {
            "default_icon": "verified",
            "title": "Verified orders only",
            "text": "Every review is tied to a real order. We do not accept unverified ones and we do not buy any."
          }
        },
        {
          "type": "rule",
          "settings": {
            "default_icon": "critical",
            "title": "Critical reviews stay up",
            "text": "We do not remove them and we do not bury them. There is a filter to read them first if you want."
          }
        },
        {
          "type": "rule",
          "settings": {
            "default_icon": "answers",
            "title": "Kristi answers",
            "text": "Personally, on most of them, and always on the critical ones."
          }
        },
        {
          "type": "rule",
          "settings": {
            "default_icon": "photos",
            "title": "Points for photos",
            "text": "50 for a photo, 200 for a video. Because a photo of a real person is worth more than anything we could shoot."
          }
        }
      ]
    }
  ]
}
{% endschema %}
