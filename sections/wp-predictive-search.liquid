{%- comment -%}
  Search overlay results (desktop). Fetched by assets/wp-search-overlay.js via
  section_id=wp-predictive-search. Left column only: DID YOU MEAN (queries, max 3, no counts),
  GUIDES (articles, max 2, live blog excluded), FROM THE LIVE (articles, max 1, live blog only).
  Collections and pages are not shown. Right panel: WIGS heading, up to 10 product cards (horizontal scroll) and the
  "See all results" link. JS fills the result count from sections/wp-search-count.liquid.

  Every article is printed into the GUIDES list with its blog handle. The JS splits GUIDES / FROM THE LIVE
  and applies the 2 / 1 limits, because a section fetched through the Section Rendering API only sees its
  schema defaults, never values set in the editor. The header's "live blog" setting reaches the JS as data-live-blog.
{%- endcomment -%}
{%- liquid
  assign resources = predictive_search.resources
  assign total_results = resources.queries.size | plus: resources.articles.size | plus: resources.products.size
-%}
<div id="wp-predictive-search-results" data-live-blog="{{ section.settings.live_blog_handle | handleize }}">
  {%- if predictive_search.performed -%}
    {%- if total_results > 0 -%}
      <div class="wp-so__layout">
        <div class="wp-so__left">
          <div class="wp-so__group" data-wp-so-group="queries"{% if resources.queries.size == 0 %} hidden{% endif %}>
            <h2 class="wp-so__heading" id="wp-so-queries">Did you mean</h2>
            <ul class="wp-so__list" role="group" aria-labelledby="wp-so-queries">
              {%- for query in resources.queries limit: 3 -%}
                <li
                  id="wp-so-option-query-{{ forloop.index }}"
                  class="wp-so__item"
                  role="option"
                  aria-selected="false"
                >
                  <a href="{{ query.url }}" class="wp-so__link" tabindex="-1">{{ query.text | escape }}</a>
                </li>
              {%- endfor -%}
            </ul>
          </div>

          <div class="wp-so__group" data-wp-so-group="guides"{% if resources.articles.size == 0 %} hidden{% endif %}>
            <h2 class="wp-so__heading" id="wp-so-guides">Guides</h2>
            <ul class="wp-so__list" role="group" aria-labelledby="wp-so-guides">
              {%- for article in resources.articles -%}
                {%- assign blog_handle = article.url | split: '/blogs/' | last | split: '/' | first -%}
                <li
                  id="wp-so-option-article-{{ forloop.index }}"
                  class="wp-so__item"
                  role="option"
                  aria-selected="false"
                  data-blog="{{ blog_handle }}"
                >
                  <a href="{{ article.url }}" class="wp-so__link" tabindex="-1">{{ article.title | escape }}</a>
                </li>
              {%- endfor -%}
            </ul>
          </div>

          <div class="wp-so__group" data-wp-so-group="live" hidden>
            <h2 class="wp-so__heading" id="wp-so-live">From the live</h2>
            <ul class="wp-so__list" role="group" aria-labelledby="wp-so-live"></ul>
          </div>
        </div>

        {%- if resources.products.size > 0 -%}
          <div class="wp-so__panel">
            <div class="wp-so__panel-heading">
              <img
                class="wp-so__panel-icon"
                src="{{ 'wp-search-overlay-wigs-icon.svg' | asset_url }}"
                alt=""
                width="24"
                height="24"
              >
              <h2 class="wp-so__panel-title">Wigs</h2>
            </div>

            <ul class="wp-so__cards">
              {%- for product in resources.products limit: 10 -%}
                {%- liquid
                  assign variant = product.selected_or_first_available_variant
                  assign tile_image = variant.featured_image | default: product.featured_image

                  capture short_name
                    render 'aria-product-short-name', product: product
                  endcapture
                  assign short_name = short_name | strip

                  capture clean_title
                    render 'aria-strip-supplier', text: product.title
                  endcapture
                  assign title_parts = clean_title | split: '|'
                  assign series = ''
                  if title_parts.size > 1
                    assign series = title_parts[1] | strip | remove: ' Collection' | strip
                  endif

                  assign review_rating = product.metafields.reviews.rating.value
                  assign review_count = product.metafields.reviews.rating_count.value

                  assign meta = series
                  if review_rating != blank
                    if meta != blank
                      assign meta = meta | append: ' · '
                    endif
                    assign rating_text = review_rating.rating | round: 1
                    assign meta = meta | append: rating_text
                  endif
                  if review_count != blank
                    if meta != blank
                      assign meta = meta | append: ' · '
                    endif
                    assign meta = meta | append: review_count
                  endif

                  comment
                    Tile variant = the first available variant (selected_or_first_available_variant), the same one
                    whose photo the tile shows. No variant id: the tile stays a link to the product page.
                  endcomment
                  assign tile_mode = 'link'
                  if variant.id != blank
                    if product.available and variant.available
                      assign tile_mode = 'add'
                    else
                      assign tile_mode = 'soldout'
                    endif
                  endif
                -%}
                <li class="wp-so__card">
                  <a class="wp-so__card-media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                    {%- if product.featured_image -%}
                      {{ product.featured_image | image_url: width: 500 | image_tag: width: 250, height: 315, loading: 'lazy', alt: '', class: 'wp-so__card-img' }}
                    {%- endif -%}
                    {%- capture so_preorder -%}{%- render 'wp-is-preorder', product: product -%}{%- endcapture -%}
                    {%- if product.available == false -%}<span class="wp-so__chip wp-so__chip--sold-out">Sold out</span>
                    {%- elsif so_preorder contains 'true' -%}<span class="wp-so__chip wp-so__chip--preorder">Pre-order</span>
                    {%- else -%}<span class="wp-so__chip">In stock</span>{%- endif -%}
                    <span class="wp-so__card-name">{{ short_name | escape }}</span>
                  </a>
                  <div class="wp-so__card-info">
                    {%- if tile_mode == 'add' -%}
                      <button
                        type="button"
                        class="wp-so__tile"
                        data-wp-so-add
                        data-variant-id="{{ variant.id }}"
                        data-product-url="{{ product.url }}"
                        aria-label="Add {{ product.title | escape }} to cart"
                      >
                    {%- elsif tile_mode == 'soldout' -%}
                      <button
                        type="button"
                        class="wp-so__tile wp-so__tile--soldout"
                        aria-disabled="true"
                        aria-label="Add {{ product.title | escape }} to cart (sold out)"
                      >
                    {%- else -%}
                      <a class="wp-so__tile" href="{{ product.url }}" aria-label="View {{ product.title | escape }}">
                    {%- endif -%}
                      {%- if tile_image -%}
                        {{ tile_image | image_url: width: 80, height: 80, crop: 'center' | image_tag: width: 40, height: 40, loading: 'lazy', alt: '', class: 'wp-so__tile-img' }}
                      {%- endif -%}
                      <img class="wp-so__tile-icon" src="{{ 'wp-search-overlay-quick-add-icon.svg' | asset_url }}" alt="" width="20" height="20">
                    {%- if tile_mode == 'link' -%}</a>{%- else -%}</button>{%- endif -%}
                    <a class="wp-so__card-meta" href="{{ product.url }}">
                      <span class="wp-so__card-meta-text">{{ meta | escape }}</span>
                      <span class="wp-so__card-price">{{ product.price | money_without_trailing_zeros }}</span>
                    </a>
                  </div>
                </li>
              {%- endfor -%}
            </ul>

            <a
              class="wp-so__see-all"
              href="{{ routes.search_url }}?q={{ predictive_search.terms | url_encode }}&amp;type=product"
              data-wp-so-see-all
            >See all <span data-wp-so-count hidden></span><span data-wp-so-noun>results</span> for “{{ predictive_search.terms | escape }}”</a>
          </div>
        {%- endif -%}
      </div>
    {%- else -%}
      <p class="wp-so__empty">No results for “{{ predictive_search.terms | escape }}”</p>
    {%- endif -%}

    <span class="visually-hidden" role="status" aria-live="polite" data-wp-so-announce></span>
    <span
      class="hidden"
      data-predictive-search-live-region-count-value
      data-total-results="{{ total_results }}"
    >
      {%- if total_results == 0 -%}
        No results for “{{ predictive_search.terms | escape }}”
      {%- else -%}
        {{ total_results }} results
      {%- endif -%}
    </span>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Search overlay results",
  "settings": [
    {
      "type": "text",
      "id": "live_blog_handle",
      "label": "Live blog handle (empty hides From the live)",
      "info": "Used for the GUIDES / FROM THE LIVE split. The header setting wins."
    }
  ]
}
{% endschema %}
