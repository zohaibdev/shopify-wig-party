{{ 'section-aria-meet-the-icons.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign has_video = false
  if section.settings.video != blank or section.settings.video_url != blank
    assign has_video = true
  endif
-%}

<section class="aria-meet-icons">
  <div class="aria-meet-icons__inner">
    <div class="aria-meet-icons__stage">
      {%- comment -%}
        Media layer. A merchant-selected video takes precedence over the still image;
        the image is also used as the video poster so there is never an empty frame.
      {%- endcomment -%}
      <div class="aria-meet-icons__media">
        {%- if section.settings.video != blank -%}
          {{
            section.settings.video
            | video_tag:
              image_size: '1600x',
              autoplay: section.settings.video_autoplay,
              loop: true,
              muted: true,
              controls: section.settings.video_show_controls,
              playsinline: true,
              class: 'aria-meet-icons__video'
          }}
        {%- elsif section.settings.video_url != blank -%}
          {%- comment -%}
            Built by hand from video_url.type / .id, the way Dawn's own video.liquid
            does it. `external_video_tag` only accepts a product media object and
            raises "does not support VideoUrlDrop" on a video_url setting.
          {%- endcomment -%}
          {%- liquid
            assign video_id = section.settings.video_url.id
            assign autoplay_params = ''
            if section.settings.video_autoplay
              assign autoplay_params = '&autoplay=1&mute=1&muted=1'
            endif
            assign control_params = ''
            unless section.settings.video_show_controls
              assign control_params = '&controls=0'
            endunless
          -%}
          <div class="aria-meet-icons__video-external">
            {%- if section.settings.video_url.type == 'youtube' -%}
              <iframe
                class="aria-meet-icons__video"
                src="https://www.youtube.com/embed/{{ video_id }}?enablejsapi=1&playsinline=1&loop=1&playlist={{ video_id }}{{ autoplay_params }}{{ control_params }}"
                title="{{ section.settings.heading | default: 'Video' | escape }}"
                allow="autoplay; encrypted-media; picture-in-picture"
                allowfullscreen
                loading="lazy"
              ></iframe>
            {%- else -%}
              <iframe
                class="aria-meet-icons__video"
                src="https://player.vimeo.com/video/{{ video_id }}?loop=1&playsinline=1{{ autoplay_params }}{{ control_params }}"
                title="{{ section.settings.heading | default: 'Video' | escape }}"
                allow="autoplay; encrypted-media; picture-in-picture"
                allowfullscreen
                loading="lazy"
              ></iframe>
            {%- endif -%}
          </div>
        {%- else -%}
          {%- comment -%}
            Mobile (Figma 6576:12146) crops into its own photo, the theme's
            wp-meet-the-icons-bg.jpg (1264x845), not the wide 1360x612 desktop still.
            A <picture> source swaps it in below 750px only, so desktop keeps its <img>
            exactly as before. It is drawn at 338.75% of the 343px photo box, so
            `339vw` is the width the browser needs to pick a sharp file.
          {%- endcomment -%}
          <picture>
            {%- if section.settings.mobile_image != blank -%}
              <source
                media="(max-width: 749px)"
                srcset="{{ section.settings.mobile_image | image_url: width: 750 }} 750w, {{ section.settings.mobile_image | image_url: width: 1100 }} 1100w, {{ section.settings.mobile_image | image_url: width: 1500 }} 1500w, {{ section.settings.mobile_image | image_url: width: 2200 }} 2200w"
                sizes="339vw"
                width="{{ section.settings.mobile_image.width }}"
                height="{{ section.settings.mobile_image.height }}"
              >
            {%- else -%}
              <source
                media="(max-width: 749px)"
                srcset="{{ 'wp-meet-the-icons-bg.jpg' | asset_img_url: '750x' }} 750w, {{ 'wp-meet-the-icons-bg.jpg' | asset_img_url: '1100x' }} 1100w, {{ 'wp-meet-the-icons-bg.jpg' | asset_url }} 1264w"
                sizes="339vw"
                width="1264"
                height="845"
              >
            {%- endif -%}
            {%- if section.settings.image != blank -%}
              {{
                section.settings.image
                | image_url: width: 1600
                | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 990px) 1360px, 100vw',
                  widths: '480,768,1024,1400,1600',
                  class: 'aria-meet-icons__image',
                  alt: section.settings.image.alt | default: section.settings.heading
              }}
            {%- else -%}
              {%- comment -%} Placeholder still from the V4 design until a merchant sets media. {%- endcomment -%}
              <img
                src="{{ 'wp-meet-the-icons-bg.jpg' | asset_url }}"
                alt=""
                width="1440"
                height="612"
                loading="lazy"
                class="aria-meet-icons__image"
              >
            {%- endif -%}
          </picture>
        {%- endif -%}
        <span class="aria-meet-icons__scrim" aria-hidden="true"><span></span></span>
      </div>

      {%- if section.settings.show_signature -%}
        <span class="aria-meet-icons__signature" aria-hidden="true">
          {%- if section.settings.signature_image != blank -%}
            {{
              section.settings.signature_image
              | image_url: width: 800
              | image_tag: loading: 'lazy', widths: '400,800', class: 'aria-meet-icons__signature-img', alt: ''
            }}
          {%- else -%}
            <img
              src="{{ 'wp-kristi-signature.svg' | asset_url }}"
              alt=""
              width="401"
              height="155"
              loading="lazy"
              class="aria-meet-icons__signature-img"
            >
          {%- endif -%}
        </span>
      {%- endif -%}

      <div class="aria-meet-icons__panel">
        {%- if section.settings.eyebrow != blank -%}
          <span class="aria-meet-icons__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="aria-meet-icons__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <p class="aria-meet-icons__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a
            href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
            class="aria-meet-icons__btn"
          >
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.aria-meet-the-icons.name",
  "tag": "section",
  "class": "aria-meet-the-icons-section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.aria-meet-the-icons.settings.header_media.content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.aria-meet-the-icons.settings.image.label",
      "info": "t:sections.aria-meet-the-icons.settings.image.info"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Shown below 750px instead of the image above, cropped to the bottom half of the mobile card. Use a landscape photo (about 1264 x 845) with the face right of centre. Empty uses the theme's default mobile photo. Ignored when a video is set."
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:sections.aria-meet-the-icons.settings.video.label"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube", "vimeo"],
      "label": "t:sections.aria-meet-the-icons.settings.video_url.label",
      "info": "t:sections.aria-meet-the-icons.settings.video_url.info"
    },
    {
      "type": "checkbox",
      "id": "video_autoplay",
      "default": true,
      "label": "t:sections.aria-meet-the-icons.settings.video_autoplay.label",
      "info": "t:sections.aria-meet-the-icons.settings.video_autoplay.info"
    },
    {
      "type": "checkbox",
      "id": "video_show_controls",
      "default": true,
      "label": "t:sections.aria-meet-the-icons.settings.video_show_controls.label"
    },
    {
      "type": "header",
      "content": "t:sections.aria-meet-the-icons.settings.header_content.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "default": "The Icons Collection",
      "label": "t:sections.aria-meet-the-icons.settings.eyebrow.label"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Meet the Icons",
      "label": "t:sections.aria-meet-the-icons.settings.heading.label"
    },
    {
      "type": "text",
      "id": "subheading",
      "default": "Hand-tied, heat-friendly, in stock now",
      "label": "t:sections.aria-meet-the-icons.settings.subheading.label"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Shop the Icons",
      "label": "t:sections.aria-meet-the-icons.settings.button_label.label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.aria-meet-the-icons.settings.button_link.label"
    },
    {
      "type": "header",
      "content": "t:sections.aria-meet-the-icons.settings.header_signature.content"
    },
    {
      "type": "checkbox",
      "id": "show_signature",
      "default": true,
      "label": "t:sections.aria-meet-the-icons.settings.show_signature.label"
    },
    {
      "type": "image_picker",
      "id": "signature_image",
      "label": "t:sections.aria-meet-the-icons.settings.signature_image.label",
      "info": "t:sections.aria-meet-the-icons.settings.signature_image.info"
    }
  ],
  "presets": [
    {
      "name": "t:sections.aria-meet-the-icons.presets.name"
    }
  ]
}
{% endschema %}
