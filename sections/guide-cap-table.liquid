{% comment %}
  Measure & cap guide: "The four constructions" comparison table (desktop).
  Figma: 7368:202 (panel 7368:204, header 7368:205, table 7368:209).
  Static content only: nothing in this section is clickable.
{% endcomment %}

{{ 'design-tokens.css' | asset_url | stylesheet_tag }}
{{ 'section-guide-cap-table.css' | asset_url | stylesheet_tag }}

{%- assign row_keys = 'what_it_is,feels,part_it,best_for' | split: ',' -%}

<div class="wp-gct" id="cap-constructions">
  {%- if section.settings.bg_image != blank -%}
    {{
      section.settings.bg_image
      | image_url: width: 2880
      | image_tag:
        class: 'wp-gct__bg',
        widths: '1440, 2160, 2880',
        sizes: '100vw',
        loading: 'lazy',
        alt: ''
    }}
  {%- else -%}
    <img
      class="wp-gct__bg"
      src="{{ 'guide-cap-table-bg.jpg' | asset_url }}"
      width="2880"
      height="2052"
      loading="lazy"
      alt=""
    >
  {%- endif -%}

  <div class="wp-gct__panel">
    <div class="wp-gct__header">
      {%- if section.settings.label != blank -%}
        <p class="wp-gct__label">{{ section.settings.label | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="wp-gct__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>

    <table class="wp-gct__table">
      <caption class="visually-hidden">{{ section.settings.caption | escape }}</caption>
      <colgroup>
        <col class="wp-gct__col-label">
        {%- for block in section.blocks -%}
          <col class="wp-gct__col-data">
        {%- endfor -%}
      </colgroup>
      <thead>
        <tr>
          <td class="wp-gct__corner"></td>
          {%- for block in section.blocks -%}
            <th scope="col" class="wp-gct__col-head" {{ block.shopify_attributes }}>
              <span class="wp-gct__icon">
                {%- if block.settings.icon != blank -%}
                  {{
                    block.settings.icon
                    | image_url: width: 94
                    | image_tag: width: 39, height: 47, loading: 'lazy', alt: ''
                  }}
                {%- else -%}
                  <img
                    src="{{ 'guide-cap-icon-' | append: block.settings.default_icon | append: '.svg' | asset_url }}"
                    width="39"
                    height="47"
                    loading="lazy"
                    alt=""
                  >
                {%- endif -%}
              </span>
              <span class="wp-gct__col-name">{{ block.settings.name | escape }}</span>
            </th>
          {%- endfor -%}
        </tr>
      </thead>
      <tbody>
        {%- for key in row_keys -%}
          {%- assign label_id = 'row_' | append: forloop.index | append: '_label' -%}
          <tr class="wp-gct__row{% if forloop.first %} wp-gct__row--lead{% endif %}">
            <th scope="row" class="wp-gct__row-label">{{ section.settings[label_id] | escape }}</th>
            {%- for block in section.blocks -%}
              <td class="wp-gct__cell{% if forloop.first %} wp-gct__cell--primary{% endif %}">
                {{- block.settings[key] | escape -}}
              </td>
            {%- endfor -%}
          </tr>
        {%- endfor -%}
      </tbody>
    </table>

    {%- comment -%} Mobile (Figma 7732:13044): one card per construction, shown below 750px only. {%- endcomment -%}
    <div class="wp-cap-cards">
      {%- for block in section.blocks -%}
        <div class="wp-cap-card">
          <div class="wp-cap-card__head">
            <span class="wp-cap-card__icon">
              {%- if block.settings.icon != blank -%}
                {{
                  block.settings.icon
                  | image_url: width: 72
                  | image_tag: width: 30, height: 36, loading: 'lazy', alt: ''
                }}
              {%- else -%}
                <img
                  src="{{ 'guide-cap-icon-' | append: block.settings.default_icon | append: '.svg' | asset_url }}"
                  width="30"
                  height="36"
                  loading="lazy"
                  alt=""
                >
              {%- endif -%}
            </span>
            <h3 class="wp-cap-card__name">{{ block.settings.name | escape }}</h3>
          </div>
          <dl class="wp-cap-card__rows">
            {%- for key in row_keys -%}
              {%- assign label_id = 'row_' | append: forloop.index | append: '_label' -%}
              <div class="wp-cap-card__row">
                <dt class="wp-cap-card__label">{{ section.settings[label_id] | escape }}</dt>
                <dd class="wp-cap-card__value">{{ block.settings[key] | escape }}</dd>
              </div>
            {%- endfor -%}
          </dl>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Guide cap table",
  "tag": "section",
  "class": "section-guide-cap-table",
  "max_blocks": 4,
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background photo",
      "info": "Empty uses the default hair photo."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "THE FOUR CONSTRUCTIONS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "In plain language, once"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Table caption (screen readers only)",
      "default": "Comparison of the four cap constructions"
    },
    {
      "type": "header",
      "content": "Row labels"
    },
    {
      "type": "text",
      "id": "row_1_label",
      "label": "Row 1 label",
      "default": "What it is"
    },
    {
      "type": "text",
      "id": "row_2_label",
      "label": "Row 2 label",
      "default": "Feels"
    },
    {
      "type": "text",
      "id": "row_3_label",
      "label": "Row 3 label",
      "default": "Part it"
    },
    {
      "type": "text",
      "id": "row_4_label",
      "label": "Row 4 label",
      "default": "Best for"
    },
    {
      "type": "text",
      "id": "row_5_label",
      "label": "Row 5 label",
      "default": "From"
    },
    {
      "type": "text",
      "id": "row_6_label",
      "label": "Row 6 label",
      "default": "Live now"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Construction",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "select",
          "id": "default_icon",
          "label": "Default icon (used when Icon is empty)",
          "options": [
            { "value": "hand-tied", "label": "Hand-tied" },
            { "value": "extended-lace", "label": "Extended lace front" },
            { "value": "full-mono", "label": "Full mono" },
            { "value": "mono-topper", "label": "Mono topper" }
          ],
          "default": "hand-tied"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Hand-tied"
        },
        {
          "type": "text",
          "id": "what_it_is",
          "label": "What it is",
          "default": "Every hair tied by hand"
        },
        {
          "type": "text",
          "id": "feels",
          "label": "Feels",
          "default": "Almost weightless"
        },
        {
          "type": "text",
          "id": "part_it",
          "label": "Part it",
          "default": "Anywhere"
        },
        {
          "type": "text",
          "id": "best_for",
          "label": "Best for",
          "default": "All-day, every day"
        },
        {
          "type": "text",
          "id": "from_price",
          "label": "From (price text)",
          "default": "$412"
        },
        {
          "type": "text",
          "id": "live_now",
          "label": "Live now (count text)",
          "default": "84"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Guide cap table",
      "blocks": [
        {
          "type": "column",
          "settings": {
            "default_icon": "hand-tied",
            "name": "Hand-tied",
            "what_it_is": "Every hair tied by hand",
            "feels": "Almost weightless",
            "part_it": "Anywhere",
            "best_for": "All-day, every day",
            "from_price": "",
            "live_now": ""
          }
        },
        {
          "type": "column",
          "settings": {
            "default_icon": "extended-lace",
            "name": "Extended lace front",
            "what_it_is": "Deeper lace at the front, wefted behind",
            "feels": "Light",
            "part_it": "Front section only",
            "best_for": "Styling variety, first wig",
            "from_price": "",
            "live_now": ""
          }
        },
        {
          "type": "column",
          "settings": {
            "default_icon": "full-mono",
            "name": "Full mono",
            "what_it_is": "Monofilament top, reads as scalp",
            "feels": "Medium",
            "part_it": "Anywhere",
            "best_for": "Full hair loss",
            "from_price": "",
            "live_now": ""
          }
        },
        {
          "type": "column",
          "settings": {
            "default_icon": "mono-topper",
            "name": "Mono topper",
            "what_it_is": "Partial piece for the crown",
            "feels": "You forget it",
            "part_it": "Crown only",
            "best_for": "Thinning at the crown",
            "from_price": "",
            "live_now": ""
          }
        }
      ]
    }
  ]
}
{% endschema %}
