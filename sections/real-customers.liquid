{{ 'section-aria-real-customers.css' | asset_url | stylesheet_tag }}
<script src="{{ 'aria-real-customers.js' | asset_url }}" defer="defer"></script>

<section class="aria-real-customers" style="--aria-rc-bg: {{ section.settings.background_color }};">
  <div class="aria-real-customers__inner">
    <div class="aria-real-customers__header">
      {%- if section.settings.show_rating_badge and section.settings.rating_badge_text != blank -%}
        <div class="aria-real-customers__badge">
          <span class="aria-real-customers__badge-stars" aria-hidden="true">
            {%- for i in (1..5) -%}
              {%- render 'aria-icon', name: 'star' -%}
            {%- endfor -%}
          </span>
          <span>{{ section.settings.rating_badge_text }}</span>
        </div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="aria-real-customers__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="aria-real-customers__carousel" data-aria-rc-carousel>
        <div class="swiper aria-real-customers__swiper" data-aria-rc-swiper>
          <div class="swiper-wrapper">
            {%- for block in section.blocks -%}
              <div class="swiper-slide aria-real-customers__slide" {{ block.shopify_attributes }}>
                <div class="aria-real-customers__frame">
                  {%- liquid
                    # A block can carry its own video; blocks that do not fall back to the
                    # section-level video so every slide can be a video without duplicating
                    # the file on each block. Nothing is hardcoded — both come from settings.
                    assign rc_video = block.settings.video
                    if rc_video == blank
                      assign rc_video = section.settings.fallback_video
                    endif

                    assign has_video = false
                    if rc_video != blank
                      assign has_video = true
                    endif

                    assign has_external_video = false
                    if has_video == false and block.settings.video_url != blank
                      assign has_external_video = true
                    endif

                    assign rc_title = block.settings.caption | default: section.settings.heading
                  -%}

                  {%- comment -%}
                    Poster for the slide. Used by every branch, so it is captured once.
                    On a video slide this becomes the <video poster>, so the designed photo
                    is what shows while the file buffers — a video slide is never a blank box.
                  {%- endcomment -%}
                  {%- capture story_poster -%}
                    {%- if block.settings.image != blank -%}
                      {{
                        block.settings.image
                        | image_url: width: 800
                        | image_tag:
                          loading: 'lazy',
                          sizes: '(min-width: 990px) 343px, 70vw',
                          widths: '320,480,686,800',
                          class: 'aria-real-customers__image',
                          alt: block.settings.image.alt | default: block.settings.caption
                      }}
                    {%- elsif rc_video != blank and rc_video.preview_image != blank -%}
                      {{
                        rc_video.preview_image
                        | image_url: width: 800
                        | image_tag:
                          loading: 'lazy',
                          sizes: '(min-width: 990px) 343px, 70vw',
                          widths: '320,480,686,800',
                          class: 'aria-real-customers__image',
                          alt: block.settings.caption
                      }}
                    {%- else -%}
                      <span class="aria-real-customers__placeholder">
                        {{ 'collection-1' | placeholder_svg_tag: 'aria-real-customers__image' }}
                      </span>
                    {%- endif -%}
                  {%- endcapture -%}

                  {%- capture story_play -%}
                    <span class="aria-real-customers__play" aria-hidden="true">
                      <img
                        src="{{ 'wp-play-button.svg' | asset_url }}"
                        alt=""
                        width="70"
                        height="70"
                        loading="lazy"
                      >
                    </span>
                  {%- endcapture -%}

                  {%- if has_video -%}
                    {%- comment -%}
                      Autoplaying, muted, looping, inline video with the theme's own custom
                      controls. `controls` is deliberately absent, so no native control bar,
                      timeline, volume slider, fullscreen or PiP chrome ever appears.

                      Built by hand rather than with `video_tag` for one reason: `video_tag`
                      posts the video's OWN preview frame and offers no way to override it,
                      and this design wants the merchant's photo as the poster.

                      `muted` must be present as an ATTRIBUTE (not just set from JS) or
                      Chrome/Safari refuse the autoplay. `playsinline` is what stops iOS
                      taking the video fullscreen.
                    {%- endcomment -%}
                    {%- liquid
                      assign poster_url = ''
                      if block.settings.image != blank
                        assign poster_url = block.settings.image | image_url: width: 800
                      elsif rc_video.preview_image != blank
                        assign poster_url = rc_video.preview_image | image_url: width: 800
                      endif
                    -%}
                    <div class="aria-real-customers__media aria-real-customers__media--video" data-aria-video-media>
                      <video
                        class="aria-real-customers__video"
                        data-aria-video
                        autoplay
                        muted
                        loop
                        playsinline
                        preload="metadata"
                        {% if poster_url != blank %}
                          poster="{{ poster_url }}"
                        {% endif %}
                      >
                        {%- for source in rc_video.sources -%}
                          <source src="{{ source.url }}" type="{{ source.mime_type }}">
                        {%- endfor -%}
                      </video>

                      {%- comment -%}
                        The two controls sit in OPPOSITE bottom corners, never grouped
                        together: play/pause bottom-left, sound bottom-right. Both icons are
                        rendered and CSS shows one per `data-state`, so toggling never
                        rewrites innerHTML.
                      {%- endcomment -%}
                      <button
                        type="button"
                        class="aria-video-ctrl aria-video-ctrl--play aria-real-customers__ctrl"
                        data-aria-video-play
                        data-state="playing"
                        data-label-play="{{ 'aria_theme.video.play' | t | escape }}"
                        data-label-pause="{{ 'aria_theme.video.pause' | t | escape }}"
                        aria-label="{{ 'aria_theme.video.pause' | t }}"
                      >
                        {%- render 'aria-icon', name: 'pause', class: 'aria-video-ctrl__icon aria-video-ctrl__icon--pause' -%}
                        {%- render 'aria-icon', name: 'play', class: 'aria-video-ctrl__icon aria-video-ctrl__icon--play' -%}
                      </button>

                      <button
                        type="button"
                        class="aria-video-ctrl aria-video-ctrl--sound aria-real-customers__ctrl"
                        data-aria-video-sound
                        data-state="muted"
                        data-label-mute="{{ 'aria_theme.video.mute' | t | escape }}"
                        data-label-unmute="{{ 'aria_theme.video.unmute' | t | escape }}"
                        aria-label="{{ 'aria_theme.video.unmute' | t }}"
                      >
                        {%- render 'aria-icon', name: 'sound-off', class: 'aria-video-ctrl__icon aria-video-ctrl__icon--off' -%}
                        {%- render 'aria-icon', name: 'sound-on', class: 'aria-video-ctrl__icon aria-video-ctrl__icon--on' -%}
                      </button>
                    </div>
                  {%- elsif has_external_video -%}
                    {%- comment -%}
                      YouTube/Vimeo fall back to the previous click-to-play poster via Dawn's
                      <deferred-media>. The custom controls cannot drive a third-party iframe
                      without loading their player APIs, which this section deliberately does
                      not do, so an external URL keeps that provider's own chrome. Prefer a
                      Shopify-hosted file here — that is the branch above.
                    {%- endcomment -%}
                    {%- assign rc_video_id = block.settings.video_url.id -%}
                    <deferred-media class="aria-real-customers__media aria-real-customers__media--deferred">
                      <button
                        id="Deferred-Poster-{{ block.id }}"
                        class="aria-real-customers__poster"
                        type="button"
                        aria-label="{{ 'aria_theme.real_customers.play_story' | t: name: rc_title }}"
                      >
                        {{ story_poster }}
                        {{ story_play }}
                      </button>

                      <template>
                        {%- if block.settings.video_url.type == 'youtube' -%}
                          <iframe
                            class="aria-real-customers__video"
                            src="https://www.youtube.com/embed/{{ rc_video_id }}?enablejsapi=1&playsinline=1&loop=1&playlist={{ rc_video_id }}&autoplay=1"
                            title="{{ rc_title | escape }}"
                            allow="autoplay; encrypted-media; picture-in-picture"
                            allowfullscreen
                          ></iframe>
                        {%- else -%}
                          <iframe
                            class="aria-real-customers__video"
                            src="https://player.vimeo.com/video/{{ rc_video_id }}?loop=1&playsinline=1&autoplay=1"
                            title="{{ rc_title | escape }}"
                            allow="autoplay; encrypted-media; picture-in-picture"
                            allowfullscreen
                          ></iframe>
                        {%- endif -%}
                      </template>
                    </deferred-media>
                  {%- else -%}
                    {%- comment -%}
                      No video on this block and no section fallback set, so the slide stays
                      an image. Set a video on the block, or one section-level fallback video,
                      and it joins the video branch above.
                    {%- endcomment -%}
                    <div class="aria-real-customers__media">
                      {{ story_poster }}
                      {%- if block.settings.show_play_icon -%}
                        {{ story_play }}
                      {%- endif -%}
                    </div>
                  {%- endif -%}

                  {%- if block.settings.caption != blank -%}
                    <p class="aria-real-customers__caption">{{ block.settings.caption }}</p>
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>

        {%- if section.settings.show_navigation -%}
          <button
            type="button"
            class="aria-real-customers__nav aria-real-customers__nav--prev"
            data-aria-rc-prev
            aria-label="{{ 'aria_theme.carousel.previous' | t }}"
          >
            {%- render 'aria-icon', name: 'arrow-left' -%}
          </button>
          <button
            type="button"
            class="aria-real-customers__nav aria-real-customers__nav--next"
            data-aria-rc-next
            aria-label="{{ 'aria_theme.carousel.next' | t }}"
          >
            {%- render 'aria-icon', name: 'arrow-right' -%}
          </button>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.aria-real-customers.name",
  "tag": "section",
  "class": "aria-real-customers-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Real Customers, Real Confidence",
      "label": "t:sections.aria-real-customers.settings.heading.label"
    },
    {
      "type": "checkbox",
      "id": "show_rating_badge",
      "default": true,
      "label": "t:sections.aria-real-customers.settings.show_rating_badge.label"
    },
    {
      "type": "text",
      "id": "rating_badge_text",
      "default": "Thousands of 5-star reviews",
      "label": "t:sections.aria-real-customers.settings.rating_badge_text.label"
    },
    {
      "type": "video",
      "id": "fallback_video",
      "label": "t:sections.aria-real-customers.settings.fallback_video.label",
      "info": "t:sections.aria-real-customers.settings.fallback_video.info"
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "default": true,
      "label": "t:sections.aria-real-customers.settings.show_navigation.label"
    },
    {
      "type": "color",
      "id": "background_color",
      "default": "#000000",
      "label": "t:sections.aria-real-customers.settings.background_color.label"
    }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "t:sections.aria-real-customers.blocks.story.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.aria-real-customers.blocks.story.settings.image.label"
        },
        {
          "type": "video",
          "id": "video",
          "label": "t:sections.aria-real-customers.blocks.story.settings.video.label",
          "info": "t:sections.aria-real-customers.blocks.story.settings.video.info"
        },
        {
          "type": "video_url",
          "id": "video_url",
          "accept": ["youtube", "vimeo"],
          "label": "t:sections.aria-real-customers.blocks.story.settings.video_url.label"
        },
        {
          "type": "checkbox",
          "id": "show_play_icon",
          "default": true,
          "label": "t:sections.aria-real-customers.blocks.story.settings.show_play_icon.label",
          "info": "t:sections.aria-real-customers.blocks.story.settings.show_play_icon.info"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "t:sections.aria-real-customers.blocks.story.settings.caption.label"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "t:sections.aria-real-customers.presets.name",
      "blocks": [
        { "type": "story" },
        { "type": "story" },
        { "type": "story" },
        { "type": "story" },
        { "type": "story" }
      ]
    }
  ]
}
{% endschema %}
