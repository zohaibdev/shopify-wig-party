{{ 'section-aria-real-customers.css' | asset_url | stylesheet_tag }}
<script src="{{ 'aria-real-customers.js' | asset_url }}" defer="defer"></script>

{%- liquid
  # ==========================================================================
  # STORY SOURCE, in order of preference:
  #   1. product  -- customers wearing THIS wig, when the product names its own
  #   2. shop     -- the site-wide reel, shared with the home page instance
  #   3. blocks   -- the existing section blocks, so nothing breaks before the
  #                  definitions exist
  #
  # A shop metafield list is used rather than reading every `customer_story`
  # entry, because a list keeps the order the merchant drags them into.
  # `product` is nil on the home page, so rung 1 simply falls through there.
  # ==========================================================================
  # -- `== blank`, NOT `.size == 0`: an unset metafield is nil, and nil.size is nil
  # -- rather than 0, so a size comparison silently never matches.
  assign story_items = product.metafields.wigparty.customer_stories.value
  if story_items == blank
    assign story_items = shop.metafields.wigparty.customer_stories.value
  endif
  # -- Last metaobject route: every `customer_story` entry, for when no shop
  # -- metafield list has been set. Order is whatever Shopify returns here, so
  # -- the shop list above remains the way to control it.
  if story_items == blank
    assign story_items = shop.metaobjects.customer_story.values
  endif

  assign stories_from_metaobject = true
  if story_items == blank
    assign stories_from_metaobject = false
    assign story_items = section.blocks
  endif

  # -- A merchant's list can contain entries with no image/video/external-video set yet
  # -- (a `story` block or metaobject added before it's filled in), and they aren't
  # -- necessarily the last ones in the list. `rc_populated_count` -- counted here, once
  # -- -- tells the carousel below how many *real* (non-blank) items exist, without
  # -- materializing a new filtered array: `shop.metaobjects.<type>.values` is a special
  # -- Shopify resource-list type, and `slice`/`concat` do not reliably build a new array
  # -- out of it (tried, and it silently produced an empty list) the way they do for a
  # -- plain array -- only iterating and indexing the original list are safe here.
  assign rc_populated_count = 0
  assign rc_keep = ''
  assign rc_seen_videos = ''
  for rc_scan_item in story_items
    assign rc_scan_has_data = false
    if stories_from_metaobject
      if rc_scan_item.image.value != blank or rc_scan_item.video.value != blank or rc_scan_item.video_url.value != blank
        assign rc_scan_has_data = true
      endif
    else
      if rc_scan_item.settings.image != blank or rc_scan_item.settings.video != blank or rc_scan_item.settings.video_url != blank
        assign rc_scan_has_data = true
      endif
    endif
    # -- Each video plays once: skip a story whose video already appeared in this
    # -- reel, or the one the page shows elsewhere (exclude_video, e.g. Why Wig Party).
    if stories_from_metaobject
      assign rc_scan_key = rc_scan_item.system.handle
      assign rc_scan_video_id = rc_scan_item.video.value.id
    else
      assign rc_scan_key = rc_scan_item.id
      assign rc_scan_video_id = rc_scan_item.settings.video.id
    endif
    if rc_scan_has_data and rc_scan_video_id != blank
      assign rc_vid_key = '|' | append: rc_scan_video_id | append: '|'
      if rc_seen_videos contains rc_vid_key
        assign rc_scan_has_data = false
      elsif section.settings.exclude_video != blank and section.settings.exclude_video.id == rc_scan_video_id
        assign rc_scan_has_data = false
      endif
      assign rc_seen_videos = rc_seen_videos | append: rc_vid_key
    endif
    if rc_scan_has_data
      assign rc_populated_count = rc_populated_count | plus: 1
      assign rc_keep = rc_keep | append: '|' | append: rc_scan_key | append: '|'
    endif
  endfor
-%}

<section class="aria-real-customers{% if section.settings.layout_variant == 'product' %} aria-real-customers--product{% endif %}" style="--aria-rc-bg: {{ section.settings.background_color }};">
  <div class="aria-real-customers__inner">
    <div class="aria-real-customers__header">
      {%- if section.settings.show_rating_badge and section.settings.rating_badge_text != blank -%}
        <div class="aria-real-customers__badge">
          <span class="aria-real-customers__badge-stars" aria-hidden="true">
            {%- for i in (1..5) -%}
              {%- render 'aria-icon', name: 'star' -%}
            {%- endfor -%}
          </span>
          <span>{{ section.settings.rating_badge_text }}</span>
        </div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="aria-real-customers__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    {%- if rc_populated_count > 0 -%}
      <div class="aria-real-customers__carousel" data-aria-rc-carousel>
        <div class="swiper aria-real-customers__swiper" data-aria-rc-swiper>
          <div class="swiper-wrapper">
            {%- comment -%}
              With `rewind` (see the JS file for why not `loop`), the two ends of the list
              have no real neighbour to peek at — a plain rewind carousel shows empty space
              there instead of the coverflow's usual overlapping card. Two boundary clones on
              each side (copies of the last two REAL (non-blank) items before the real list,
              the first two after it) means there is always something to see, at the cost of
              this not being a mathematically endless loop — clicking through eventually shows
              the same two photos twice in a row at the seam, which reads as a fluid transition
              given the very short story data this section is limited to (`max_blocks: 12`),
              rather than a distracting glitch.

              "Real" slides and both clone pairs all skip any entry with no image/video set (a
              `story` block/metaobject that exists but hasn't been filled in yet) — found by
              scanning `story_items` directly (forward for the real loop and the "after"
              clones, `reversed` for the "before" clones) rather than by assuming the blanks
              sit at a fixed position, since a merchant's list can have them anywhere.
            {%- endcomment -%}
            {%- if rc_populated_count > 1 -%}
              {%- liquid
                assign rc_clone_before_1 = blank
                assign rc_clone_before_2 = blank
                for rc_item in story_items reversed
                  assign rc_item_has_data = false
                  if stories_from_metaobject
                    assign rc_item_key = '|' | append: rc_item.system.handle | append: '|'
                  else
                    assign rc_item_key = '|' | append: rc_item.id | append: '|'
                  endif
                  if rc_keep contains rc_item_key
                    assign rc_item_has_data = true
                  endif
                  if rc_item_has_data
                    if rc_clone_before_2 == blank
                      assign rc_clone_before_2 = rc_item
                    elsif rc_clone_before_1 == blank
                      assign rc_clone_before_1 = rc_item
                      break
                    endif
                  endif
                endfor
              -%}
              {%- render 'aria-real-customers-slide',
                block: rc_clone_before_1,
                stories_from_metaobject: stories_from_metaobject,
                section: section,
                is_clone: true
              -%}
              {%- render 'aria-real-customers-slide',
                block: rc_clone_before_2,
                stories_from_metaobject: stories_from_metaobject,
                section: section,
                is_clone: true
              -%}
            {%- endif -%}

            {%- for block in story_items -%}
              {%- liquid
                assign rc_real_has_data = false
                if stories_from_metaobject
                  assign rc_real_key = '|' | append: block.system.handle | append: '|'
                else
                  assign rc_real_key = '|' | append: block.id | append: '|'
                endif
                if rc_keep contains rc_real_key
                  assign rc_real_has_data = true
                endif
              -%}
              {%- unless rc_real_has_data -%}
                {%- continue -%}
              {%- endunless -%}
              {%- render 'aria-real-customers-slide',
                block: block,
                stories_from_metaobject: stories_from_metaobject,
                section: section,
                is_clone: false
              -%}
            {%- endfor -%}

            {%- if rc_populated_count > 1 -%}
              {%- liquid
                assign rc_clone_after_1 = blank
                assign rc_clone_after_2 = blank
                for rc_item in story_items
                  assign rc_item_has_data = false
                  if stories_from_metaobject
                    assign rc_item_key = '|' | append: rc_item.system.handle | append: '|'
                  else
                    assign rc_item_key = '|' | append: rc_item.id | append: '|'
                  endif
                  if rc_keep contains rc_item_key
                    assign rc_item_has_data = true
                  endif
                  if rc_item_has_data
                    if rc_clone_after_1 == blank
                      assign rc_clone_after_1 = rc_item
                    elsif rc_clone_after_2 == blank
                      assign rc_clone_after_2 = rc_item
                      break
                    endif
                  endif
                endfor
              -%}
              {%- render 'aria-real-customers-slide',
                block: rc_clone_after_1,
                stories_from_metaobject: stories_from_metaobject,
                section: section,
                is_clone: true
              -%}
              {%- render 'aria-real-customers-slide',
                block: rc_clone_after_2,
                stories_from_metaobject: stories_from_metaobject,
                section: section,
                is_clone: true
              -%}
            {%- endif -%}
          </div>
        </div>

        {%- if section.settings.show_navigation -%}
          <button
            type="button"
            class="aria-real-customers__nav aria-real-customers__nav--prev"
            data-aria-rc-prev
            aria-label="{{ 'aria_theme.carousel.previous' | t }}"
          >
            {%- render 'aria-icon', name: 'arrow-left' -%}
            {%- comment -%} Mobile long arrow (Figma 6576:10350); CSS shows one or the other. {%- endcomment -%}
            <span class="aria-real-customers__nav-arrow" aria-hidden="true">
              {{- 'wp-pdp-shade-arrow.svg' | inline_asset_content -}}
            </span>
          </button>
          <button
            type="button"
            class="aria-real-customers__nav aria-real-customers__nav--next"
            data-aria-rc-next
            aria-label="{{ 'aria_theme.carousel.next' | t }}"
          >
            {%- render 'aria-icon', name: 'arrow-right' -%}
            <span class="aria-real-customers__nav-arrow" aria-hidden="true">
              {{- 'wp-pdp-shade-arrow.svg' | inline_asset_content -}}
            </span>
          </button>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.aria-real-customers.name",
  "tag": "section",
  "class": "aria-real-customers-section",
  "settings": [
    {
      "type": "select",
      "id": "layout_variant",
      "options": [
        {
          "value": "home",
          "label": "t:sections.aria-real-customers.settings.layout_variant.options__1.label"
        },
        {
          "value": "product",
          "label": "t:sections.aria-real-customers.settings.layout_variant.options__2.label"
        }
      ],
      "default": "home",
      "label": "t:sections.aria-real-customers.settings.layout_variant.label",
      "info": "t:sections.aria-real-customers.settings.layout_variant.info"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Real Customers, Real Confidence",
      "label": "t:sections.aria-real-customers.settings.heading.label"
    },
    {
      "type": "checkbox",
      "id": "show_rating_badge",
      "default": true,
      "label": "t:sections.aria-real-customers.settings.show_rating_badge.label"
    },
    {
      "type": "text",
      "id": "rating_badge_text",
      "default": "Thousands of 5-star reviews",
      "label": "t:sections.aria-real-customers.settings.rating_badge_text.label"
    },
    {
      "type": "video",
      "id": "fallback_video",
      "label": "t:sections.aria-real-customers.settings.fallback_video.label",
      "info": "t:sections.aria-real-customers.settings.fallback_video.info"
    },
    {
      "type": "video",
      "id": "exclude_video",
      "label": "Video shown elsewhere on the page",
      "info": "Stories with this video are left out so the same clip never shows twice."
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "default": true,
      "label": "t:sections.aria-real-customers.settings.show_navigation.label"
    },
    {
      "type": "color",
      "id": "background_color",
      "default": "#000000",
      "label": "t:sections.aria-real-customers.settings.background_color.label"
    }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "t:sections.aria-real-customers.blocks.story.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.aria-real-customers.blocks.story.settings.image.label"
        },
        {
          "type": "video",
          "id": "video",
          "label": "t:sections.aria-real-customers.blocks.story.settings.video.label",
          "info": "t:sections.aria-real-customers.blocks.story.settings.video.info"
        },
        {
          "type": "video_url",
          "id": "video_url",
          "accept": [
            "youtube",
            "vimeo"
          ],
          "label": "t:sections.aria-real-customers.blocks.story.settings.video_url.label"
        },
        {
          "type": "checkbox",
          "id": "show_play_icon",
          "default": true,
          "label": "t:sections.aria-real-customers.blocks.story.settings.show_play_icon.label",
          "info": "t:sections.aria-real-customers.blocks.story.settings.show_play_icon.info"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "t:sections.aria-real-customers.blocks.story.settings.caption.label"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "t:sections.aria-real-customers.presets.name",
      "blocks": [
        {
          "type": "story"
        },
        {
          "type": "story"
        },
        {
          "type": "story"
        },
        {
          "type": "story"
        },
        {
          "type": "story"
        }
      ]
    }
  ]
}
{% endschema %}
