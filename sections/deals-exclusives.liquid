{{ 'section-aria-deals-exclusives.css' | asset_url | stylesheet_tag }}

<section class="aria-deals{% unless section.settings.show_button %} aria-deals--no-btn{% endunless %}">
  <div class="aria-deals__inner">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="aria-deals__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="aria-deals__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="aria-deals__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="aria-deals__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign col = block.settings.collection
            assign card_title = block.settings.title_override | default: col.title
            assign card_image = block.settings.image | default: col.products.first.featured_image | default: col.featured_image
            # One destination for the whole card: the block's own link when set, otherwise
            # the selected collection's own url. Never hardcoded.
            assign card_url = block.settings.link | default: col.url
          -%}
          {%- comment -%}
            The card used to BE the <a>. It is a <div> now because the View More control has
            to be a real link (Find Your Perfect Wig's button is the link, and that section
            is the reference), and an <a> inside an <a> is invalid HTML that browsers
            un-nest.

            Whole-card clickability is preserved, not dropped: `.aria-deals__btn::after` is
            stretched over the card, so clicking anywhere still opens the collection. That
            also keeps ONE tab stop per card instead of two links to the same URL.
          {%- endcomment -%}
          <li class="aria-deals__item" {{ block.shopify_attributes }}>
            <div class="aria-deals__card{% if card_url == blank %} aria-deals__card--empty{% endif %}">

            <span class="aria-deals__media">
              {%- if card_image != blank -%}
                {{
                  card_image
                  | image_url: width: 660
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 990px) 326px, (min-width: 750px) 45vw, 90vw',
                    widths: '326,480,660',
                    class: 'aria-deals__image',
                    alt: card_image.alt | default: card_title
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'aria-deals__image aria-deals__image--placeholder' }}
              {%- endif -%}
            </span>

            <span class="aria-deals__title">
              {{- card_title | default: 'Select a collection' -}}
            </span>

            {%- comment -%}
              Rendered only when there is somewhere to go, so a card without a collection
              never shows a dead control — the same rule the reference section applies.
            {%- endcomment -%}
            {%- if card_url != blank -%}
              <a href="{{ card_url }}" class="aria-deals__btn">
                {{- section.settings.button_label | default: 'View More' -}}
              </a>
            {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>

      <script src="{{ 'aria-product-carousel.js' | asset_url }}" defer="defer"></script>
      {%- comment -%}
        Mobile-only carousel (Figma 6578:12271, its own 375px frame): fixed 169 x 200
        cards with a title and no View More button, a progress bar and prev/next. The grid
        above still renders at every width and is only hidden below 750px, so tablet and
        desktop keep their exact markup and behaviour (the same approach
        shop-by-collection.liquid takes). With no button, the whole card is the link.

        Attributes stay on their own lines: a whitespace-trimming Liquid comment between
        them welds neighbouring attribute names together and silently stops Swiper
        initialising (documented in best-sellers.liquid).
      {%- endcomment -%}
      <div
        class="aria-deals__mobile"
        data-aria-product-carousel
        data-slides-mobile="auto"
        data-slides-sm="auto"
        data-slides-md="auto"
        data-slides-desktop="auto"
        data-space-between="8"
      >
        <div class="swiper aria-deals__mobile-swiper" data-aria-carousel-swiper>
          <div class="swiper-wrapper">
            {%- for block in section.blocks -%}
              {%- liquid
                assign col = block.settings.collection
                assign card_title = block.settings.title_override | default: col.title
                assign card_image = block.settings.image | default: col.products.first.featured_image | default: col.featured_image
                assign card_url = block.settings.link | default: col.url
              -%}
              <div class="swiper-slide aria-deals__mobile-slide" {{ block.shopify_attributes }}>
                <{% if card_url != blank %}a href="{{ card_url }}"{% else %}div{% endif %} class="aria-deals__mobile-card{% if card_url == blank %} aria-deals__card--empty{% endif %}">
                  <span class="aria-deals__media">
                    {%- if card_image != blank -%}
                      {{
                        card_image
                        | image_url: width: 507
                        | image_tag:
                          loading: 'lazy',
                          sizes: '169px',
                          widths: '169,338,507',
                          class: 'aria-deals__image',
                          alt: card_image.alt | default: card_title
                      }}
                    {%- else -%}
                      {{ 'collection-1' | placeholder_svg_tag: 'aria-deals__image aria-deals__image--placeholder' }}
                    {%- endif -%}
                  </span>
                  <span class="aria-deals__title">
                    {{- card_title | default: 'Select a collection' -}}
                  </span>
                </{% if card_url != blank %}a{% else %}div{% endif %}>
              </div>
            {%- endfor -%}
          </div>
        </div>

        <div class="aria-deals__mobile-controls" data-aria-carousel-controls>
          <div class="aria-deals__mobile-progress">
            {%- comment -%}
              Dawn's base.css hides any empty div via `:empty { display: none }`, so each
              decorative bar carries an inert child to survive it.
            {%- endcomment -%}
            <div class="aria-deals__mobile-progress-track"><span aria-hidden="true"></span></div>
            <div class="aria-deals__mobile-progress-fill" data-aria-carousel-progress>
              <span aria-hidden="true"></span>
            </div>
          </div>
          <div class="aria-deals__mobile-nav">
            <button
              type="button"
              class="aria-deals__mobile-prev"
              data-aria-carousel-prev
              aria-label="{{ 'aria_theme.carousel.previous' | t }}"
            >
              <span class="aria-deals__mobile-icon">
                {{- 'wp-pdp-shade-arrow.svg' | inline_asset_content -}}
              </span>
            </button>
            <button
              type="button"
              class="aria-deals__mobile-next"
              data-aria-carousel-next
              aria-label="{{ 'aria_theme.carousel.next' | t }}"
            >
              <span class="aria-deals__mobile-icon">
                {{- 'wp-pdp-shade-arrow.svg' | inline_asset_content -}}
              </span>
            </button>
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.aria-deals-exclusives.name",
  "tag": "section",
  "class": "aria-deals-exclusives-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Deals & Exclusives",
      "label": "t:sections.aria-deals-exclusives.settings.heading.label"
    },
    {
      "type": "text",
      "id": "subheading",
      "default": "Shop by what matters most to you.",
      "label": "t:sections.aria-deals-exclusives.settings.subheading.label"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "default": true,
      "label": "Show View More button",
      "info": "Off (Home Design V7): the card itself stays the link, with no visible button."
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "View More",
      "label": "t:sections.aria-deals-exclusives.settings.button_label.label",
      "info": "t:sections.aria-deals-exclusives.settings.button_label.info"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:sections.aria-deals-exclusives.blocks.collection.name",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.aria-deals-exclusives.blocks.collection.settings.collection.label"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.aria-deals-exclusives.blocks.collection.settings.image.label",
          "info": "t:sections.aria-deals-exclusives.blocks.collection.settings.image.info"
        },
        {
          "type": "text",
          "id": "title_override",
          "label": "t:sections.aria-deals-exclusives.blocks.collection.settings.title_override.label",
          "info": "t:sections.aria-deals-exclusives.blocks.collection.settings.title_override.info"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.aria-deals-exclusives.blocks.collection.settings.link.label",
          "info": "t:sections.aria-deals-exclusives.blocks.collection.settings.link.info"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "t:sections.aria-deals-exclusives.presets.name",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
