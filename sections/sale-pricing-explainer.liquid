{%- comment -%}
  Wig Party — Sale pricing explainer (Figma 7547:4988, desktop 1440 x 626).
  Copy is Figma text and needs approval (pricing claims). Icon: image_picker, falls back to the Figma icon.
{%- endcomment -%}

{{ 'section-sale-pricing-explainer.css' | asset_url | stylesheet_tag }}

<section class="wp-sale-explainer" id="wp-sale-explainer-{{ section.id }}">
  {%- if section.settings.label != blank -%}
    <p class="wp-sale-explainer__label">{{ section.settings.label | escape }}</p>
  {%- endif -%}
  <div class="wp-sale-explainer__intro">
    {%- if section.settings.heading != blank -%}
      <h2 class="wp-sale-explainer__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.description != blank -%}
      <p class="wp-sale-explainer__description">{{ section.settings.description | escape }}</p>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="wp-sale-explainer__columns">
      {%- for block in section.blocks -%}
        <div class="wp-sale-explainer__column" {{ block.shopify_attributes }}>
          <div class="wp-sale-explainer__icon">
            {%- if block.settings.icon != blank -%}
              <img
                class="wp-sale-explainer__icon-img"
                src="{{ block.settings.icon | image_url: width: 128 }}"
                alt=""
                width="64"
                height="64"
                loading="lazy"
              >
            {%- else -%}
              <span class="wp-sale-explainer__icon-art">
                <img src="{{ 'sale-explainer-window-icon.svg' | asset_url }}" alt="" width="46" height="33" loading="lazy">
              </span>
            {%- endif -%}
          </div>
          <div class="wp-sale-explainer__copy">
            {%- if block.settings.title != blank -%}
              <p class="wp-sale-explainer__title">{{ block.settings.title | escape }}</p>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="wp-sale-explainer__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Sale pricing explainer",
  "tag": "div",
  "class": "sale-pricing-explainer",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Community exclusive"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Said plainly, once"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "This is a section written to be uncomfortable, because the current pricing is hard to explain and that is itself the problem."
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon",
          "info": "Shown at 64 x 64. Leave empty for the default window icon."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Sale pricing explainer",
      "blocks": [
        {
          "type": "column",
          "settings": {
            "title": "The compare-at is Belle Tress MSRP",
            "text": "Not an inflated number we invented. It is what the manufacturer lists."
          }
        },
        {
          "type": "column",
          "settings": {
            "title": "Our everyday price is already below it",
            "text": "Roughly 35% below, on almost everything, all the time."
          }
        },
        {
          "type": "column",
          "settings": {
            "title": "Sale prices come off that again",
            "text": "Which is how something can end up at two-thirds off MSRP — and why “sale” has stopped meaning much here."
          }
        }
      ]
    }
  ]
}
{% endschema %}
