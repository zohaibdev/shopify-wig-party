{%- comment -%}
  Wig Party — Replays archive grid. Figma internal file, node 6849:8557 (1440 x 1964).

  A quick-filter bar (QUICK, one chip per `filter` block after "Everything", and a search
  field), a four-across grid of every replay published in the LiveMeUp app, and a SHOW
  [count] MORE button. Nothing about a replay is set here (assets/aria-livemeup.js):
  • a chip matches a replay when any of its comma-separated words appears in the replay's
    title (LiveMeUp has no tags), and its count is counted from the real replays; a chip
    that matches none is hidden;
  • WATCH & SHOP opens the replay in LiveMeUp's shoppable player.
  Chips, search and "show more" run in assets/aria-replays-grid.js once the replays have
  loaded. Styles in assets/section-aria-replays-grid.css (desktop 6849:8557; mobile
  6849:8988 in its max-width 749px block).
{%- endcomment -%}

{{ 'section-aria-replays-grid.css' | asset_url | stylesheet_tag }}
{%- render 'aria-livemeup' -%}
<script src="{{ 'aria-replays-grid.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign filter_blocks = section.blocks | where: 'type', 'filter'
  assign initial = section.settings.initial_count
-%}

<div
  class="aria-replays-grid"
  style="--aria-replays-grid-bg: {{ section.settings.background_color }};"
  data-aria-replays
  data-lmu-root
  data-initial="{{ initial }}"
  data-initial-mobile="{{ section.settings.initial_count_mobile }}"
  data-step="{{ section.settings.step }}"
  data-more-label="{{ section.settings.more_label | escape }}"
>
  <div class="aria-replays-grid__inner">
    {%- comment -%} Filter bar (6849:8560). {%- endcomment -%}
    <div class="aria-replays-grid__bar" data-lmu-hide-empty>
      <div class="aria-replays-grid__quick">
        {%- if section.settings.quick_label != blank -%}
          <span class="aria-replays-grid__quick-label">{{ section.settings.quick_label }}</span>
        {%- endif -%}
        <div class="aria-replays-grid__chips" role="group" aria-label="{{ section.settings.quick_label | escape }}">
          <button
            type="button"
            class="aria-replays-grid__chip is-active"
            data-aria-replays-chip=""
            data-label="{{ section.settings.all_label | escape }}"
            aria-pressed="true"
          >
            {{- section.settings.all_label -}}
          </button>
          {%- for chip in filter_blocks -%}
            {%- liquid
              assign words = ''
              assign raw_words = chip.settings.keywords | default: chip.settings.label | downcase | split: ','
              for w in raw_words
                assign word = w | strip
                if word != blank
                  assign words = words | append: word | append: '|'
                endif
              endfor
            -%}
            <button
              type="button"
              class="aria-replays-grid__chip"
              data-aria-replays-chip="{{ words | remove_last: '|' | escape }}"
              data-label="{{ chip.settings.label | escape }}"
              aria-pressed="false"
              hidden
              {{ chip.shopify_attributes }}
            >
              {{- chip.settings.label -}}
            </button>
          {%- endfor -%}
        </div>
      </div>

      <label class="aria-replays-grid__search">
        <span class="aria-replays-grid__search-icon" aria-hidden="true">
          {{- 'wp-replays-search.svg' | inline_asset_content -}}
        </span>
        <span class="visually-hidden">{{ section.settings.search_placeholder }}</span>
        <input
          class="aria-replays-grid__search-input"
          type="search"
          placeholder="{{ section.settings.search_placeholder | escape }}"
          autocomplete="off"
          data-aria-replays-search
        >
      </label>
    </div>

    {%- comment -%} Cards (6849:8592). {%- endcomment -%}
    <div data-lmu-list data-lmu-source="replays">
      <template data-lmu-template>
        <li class="aria-replays-grid__card" data-aria-replays-card>
          <a class="aria-replays-grid__media" href="#" data-lmu-href data-lmu-play tabindex="-1" aria-hidden="true">
            <span data-lmu-cover="324"></span>
          </a>
          <div class="aria-replays-grid__body">
            <div class="aria-replays-grid__info">
              <div class="aria-replays-grid__meta">
                <p class="aria-replays-grid__date" data-lmu-date="meta"></p>
                <h3 class="aria-replays-grid__name" data-lmu-title></h3>
              </div>
            </div>
            {%- if section.settings.button_label != blank -%}
              <a class="aria-replays-grid__button" href="#" data-lmu-href data-lmu-play>{{ section.settings.button_label }}</a>
            {%- endif -%}
          </div>
        </li>
      </template>

      <ul class="aria-replays-grid__cards" role="list" data-lmu-items>
        {%- for i in (1..8) -%}
          <li class="aria-replays-grid__card" data-lmu-loading aria-hidden="true">
            <span class="aria-replays-grid__media aria-lmu-skeleton"></span>
            <span class="aria-lmu-skeleton-line"></span>
            <span class="aria-lmu-skeleton-line aria-lmu-skeleton-line--short"></span>
          </li>
        {%- endfor -%}
      </ul>
    </div>
    <p class="aria-replays-grid__empty" data-aria-replays-empty hidden>{{ section.settings.empty_text }}</p>
    <p data-lmu-empty>{{ section.settings.none_text }}</p>
    <p data-lmu-error>{{ 'aria_theme.live.lmu.unavailable' | t }}</p>

    <div class="aria-replays-grid__more-wrap">
      <button type="button" class="aria-replays-grid__more" data-aria-replays-more hidden></button>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.aria-replays-grid.name",
  "tag": "section",
  "class": "aria-replays-grid-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.aria-replays-grid.settings.source.content"
    },
    {
      "type": "color_background",
      "id": "background_color",
      "default": "#FFFFFF",
      "label": "t:sections.aria-replays-grid.settings.background_color.label"
    },
    {
      "type": "text",
      "id": "quick_label",
      "default": "QUICK",
      "label": "t:sections.aria-replays-grid.settings.quick_label.label"
    },
    {
      "type": "text",
      "id": "all_label",
      "default": "Everything",
      "label": "t:sections.aria-replays-grid.settings.all_label.label"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "default": "Search",
      "label": "t:sections.aria-replays-grid.settings.search_placeholder.label"
    },
    {
      "type": "text",
      "id": "empty_text",
      "default": "No replays match that yet.",
      "label": "t:sections.aria-replays-grid.settings.empty_text.label"
    },
    {
      "type": "text",
      "id": "none_text",
      "default": "No replays yet. Every show lands here as soon as it ends.",
      "label": "t:sections.aria-replays-grid.settings.none_text.label"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "WATCH & SHOP",
      "label": "t:sections.aria-replays-grid.settings.button_label.label"
    },
    {
      "type": "range",
      "id": "initial_count",
      "min": 4,
      "max": 48,
      "step": 4,
      "default": 12,
      "label": "t:sections.aria-replays-grid.settings.initial_count.label"
    },
    {
      "type": "range",
      "id": "initial_count_mobile",
      "min": 2,
      "max": 24,
      "step": 2,
      "default": 6,
      "label": "t:sections.aria-replays-grid.settings.initial_count_mobile.label"
    },
    {
      "type": "range",
      "id": "step",
      "min": 4,
      "max": 48,
      "step": 4,
      "default": 24,
      "label": "t:sections.aria-replays-grid.settings.step.label"
    },
    {
      "type": "text",
      "id": "more_label",
      "default": "SHOW [count] MORE",
      "label": "t:sections.aria-replays-grid.settings.more_label.label",
      "info": "t:sections.aria-replays-grid.settings.more_label.info"
    }
  ],
  "blocks": [
    {
      "type": "filter",
      "name": "t:sections.aria-replays-grid.blocks.filter.name",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "default": "On our shelf",
          "label": "t:sections.aria-replays-grid.blocks.filter.settings.label.label"
        },
        {
          "type": "text",
          "id": "keywords",
          "label": "t:sections.aria-replays-grid.blocks.filter.settings.keywords.label",
          "info": "t:sections.aria-replays-grid.blocks.filter.settings.keywords.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.aria-replays-grid.presets.name",
      "blocks": [
        { "type": "filter", "settings": { "label": "Sample sales", "keywords": "sample sale" } },
        { "type": "filter", "settings": { "label": "Blowout sales", "keywords": "blowout, blow out, % off" } }
      ]
    }
  ]
}
{% endschema %}
