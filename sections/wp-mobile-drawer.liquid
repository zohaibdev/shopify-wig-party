        },
        {
          "type": "image_picker",
          "id": "cap_item_1_image",
          "label": "Photo 1 (Hand-tied)"
        },
        {
          "type": "image_picker",
          "id": "cap_item_2_image",
          "label": "Photo 2 (Extended lace front)"
        },
        {
          "type": "image_picker",
          "id": "cap_item_3_image",
          "label": "Photo 3 (Full mono)"
        },
        {
          "type": "image_picker",
          "id": "cap_item_4_image",
          "label": "Photo 4 (Mono topper)"
        },
        {
          "type": "header",
          "content": "Group 2: By collection"
        },
        {
          "type": "text",
          "id": "group_2_title",
          "label": "Title",
          "default": "BY COLLECTION"
        },
        {
          "type": "image_picker",
          "id": "group_2_icon",
          "label": "Icon"
        },
        {
          "type": "link_list",
          "id": "group_2_menu",
          "label": "Menu"
        },
        {
          "type": "header",
          "content": "Group 3: Shop by color"
        },
        {
          "type": "text",
