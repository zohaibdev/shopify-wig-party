{%- comment -%}
  Wig Party — Find Your Colour page, "How Belle Tress names colours". Figma internal file,
  node 7009:5300 (1440 x 992).
  A centred intro (pill, title, text) over a cream panel that spells out one example colour
  name and explains its parts in three `part` cards.
  Styles in assets/section-aria-colour-naming.css.
{%- endcomment -%}

{{ 'section-aria-colour-naming.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign part_blocks = section.blocks | where: 'type', 'part'

  # -- theme.liquid only font_faces the body regular/bold and the heading base weight; the
  # -- cards also set Poppins 500 (the tags) and Montserrat 700 (the card titles).
  assign body_font_medium = settings.type_body_font | font_modify: 'weight', '500'
  assign heading_font_bold = settings.type_header_font | font_modify: 'weight', '700'
-%}
{% style %}
  {%- if body_font_medium -%}{{ body_font_medium | font_face: font_display: 'swap' }}{%- endif -%}
  {%- if heading_font_bold -%}{{ heading_font_bold | font_face: font_display: 'swap' }}{%- endif -%}
{% endstyle %}

<div class="aria-colour-naming">
  <div class="aria-colour-naming__intro">
    {%- if section.settings.eyebrow != blank -%}
      <p class="aria-colour-naming__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="aria-colour-naming__title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="aria-colour-naming__text">{{ section.settings.text }}</p>
    {%- endif -%}
  </div>

  <div class="aria-colour-naming__panel">
    {%- if section.settings.example != blank -%}
      <p class="aria-colour-naming__example">{{ section.settings.example }}</p>
    {%- endif -%}

    {%- if part_blocks.size > 0 -%}
      <ul class="aria-colour-naming__cards" role="list">
        {%- for block in part_blocks -%}
          {%- liquid
            assign fallback_index = forloop.index0 | modulo: 3 | plus: 1
            assign fallback_file = 'wp-colour-name-' | append: fallback_index | append: '.jpg'
            assign fallback_mobile = 'wp-colour-name-' | append: fallback_index | append: '-mobile.jpg'
          -%}
          <li class="aria-colour-naming__card" {{ block.shopify_attributes }}>
            <div class="aria-colour-naming__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1136
                  | image_tag: widths: '379,758,1136', sizes: '379px', alt: block.settings.image.alt, loading: 'lazy'
                }}
              {%- else -%}
                {%- comment -%}
                  Mobile (7009:4862) frames the same photos differently, so it gets its own
                  copies, pre-cropped to that framing at 2x.
                {%- endcomment -%}
                <picture>
                  <source media="(max-width: 749px)" srcset="{{ fallback_mobile | asset_url }}" width="287" height="200">
                  <img src="{{ fallback_file | asset_url }}" alt="" width="379" height="267" loading="lazy">
                </picture>
              {%- endif -%}
            </div>
            {%- if block.settings.tag != blank -%}
              <span class="aria-colour-naming__tag">{{ block.settings.tag }}</span>
            {%- endif -%}
            <div class="aria-colour-naming__copy">
              {%- if block.settings.title != blank -%}
                <h3 class="aria-colour-naming__card-title">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="aria-colour-naming__card-text">{{ block.settings.text }}</p>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.aria-colour-naming.name",
  "tag": "section",
  "class": "aria-colour-naming-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "default": "HOW BELLE TRESS NAMES COLOURS",
      "label": "t:sections.aria-colour-naming.settings.eyebrow.label"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Three parts, and only one of them matters",
      "label": "t:sections.aria-colour-naming.settings.heading.label"
    },
    {
      "type": "text",
      "id": "text",
      "default": "The names look like code because partly they are. Once you can read one you can read all of them.",
      "label": "t:sections.aria-colour-naming.settings.text.label"
    },
    {
      "type": "text",
      "id": "example",
      "default": "V Chocolate Buttercream R",
      "label": "t:sections.aria-colour-naming.settings.example.label",
      "info": "t:sections.aria-colour-naming.settings.example.info"
    }
  ],
  "blocks": [
    {
      "type": "part",
      "name": "t:sections.aria-colour-naming.blocks.part.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.aria-colour-naming.blocks.part.settings.image.label",
          "info": "t:sections.aria-colour-naming.blocks.part.settings.image.info"
        },
        {
          "type": "text",
          "id": "tag",
          "default": "THE PREFIX",
          "label": "t:sections.aria-colour-naming.blocks.part.settings.tag.label"
        },
        {
          "type": "text",
          "id": "title",
          "default": "Which collection",
          "label": "t:sections.aria-colour-naming.blocks.part.settings.title.label"
        },
        {
          "type": "textarea",
          "id": "text",
          "default": "V is Lux V. Ignore it unless you are comparing across.",
          "label": "t:sections.aria-colour-naming.blocks.part.settings.text.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.aria-colour-naming.presets.name",
      "blocks": [{ "type": "part" }, { "type": "part" }, { "type": "part" }]
    }
  ]
}
{% endschema %}
