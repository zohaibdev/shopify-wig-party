{%- comment -%}
  Wig Party — "Inside a replay". Figma internal file, node 6849:8610 (1440 x 900), first
  drawn as a chaptered replay.

  Left: badge, title, intro and the replay player card. The replay is the one named by
  ?replay=<LiveMeUp id> in the page address, else the latest one published in the LiveMeUp
  app; its card opens LiveMeUp's shoppable player, where every product she showed can be
  added to the bag. Right: the replay's date and title, then the next replays in the
  library as rows (cover, title, how long ago, date pill) that each open their own replay,
  and WATCH & SHOP THIS REPLAY. LiveMeUp does not publish chapters or a product list per
  replay outside its player, so neither is drawn here. Nothing about a replay is set here
  (assets/aria-livemeup.js). Mobile (Figma 6849:9030) in the max-width 749px block of
  section-aria-replay-chapters.css.
{%- endcomment -%}

{{ 'section-aria-replay-chapters.css' | asset_url | stylesheet_tag }}
{%- render 'aria-livemeup' -%}

{%- liquid
  # -- theme.liquid only font_faces the body regular/bold; the date pills are Poppins 500.
  assign body_font_medium = settings.type_body_font | font_modify: 'weight', '500'
-%}
{% style %}
  {%- if body_font_medium -%}{{ body_font_medium | font_face: font_display: 'swap' }}{%- endif -%}
{% endstyle %}

<div class="aria-replay-ch" style="--aria-replay-ch-bg: {{ section.settings.background_color }};" data-lmu-root>
  <div class="aria-replay-ch__inner" data-lmu-hide-empty>
    {%- comment -%} Left (6849:8612). {%- endcomment -%}
    <div class="aria-replay-ch__main">
      <div class="aria-replay-ch__copy">
        {%- if section.settings.badge != blank -%}
          <span class="aria-replay-ch__badge">{{ section.settings.badge }}</span>
        {%- endif -%}
        <div class="aria-replay-ch__copy-text">
          {%- if section.settings.heading != blank -%}
            <h2 class="aria-replay-ch__title">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <p class="aria-replay-ch__text">{{ section.settings.text }}</p>
          {%- endif -%}
        </div>
      </div>

      <div class="aria-replay-ch__card" data-lmu-featured="replay">
        <div class="aria-replay-ch__media">
          <button
            type="button"
            class="aria-replay-ch__poster"
            data-lmu-play
            aria-label="{{ section.settings.play_label | escape }}"
          >
            <span data-lmu-cover="711"></span>
            <span class="aria-replay-ch__play" aria-hidden="true">
              {{- 'wp-pdp-kristi-play.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>
      </div>
      <div class="aria-replay-ch__card" data-lmu-loading aria-hidden="true">
        <div class="aria-replay-ch__media aria-lmu-skeleton"></div>
      </div>
    </div>

    {%- comment -%} Right (6849:8627). {%- endcomment -%}
    <div class="aria-replay-ch__side">
      <p class="aria-replay-ch__header" data-lmu-featured="replay" data-lmu-date="header"></p>

      <div class="aria-replay-ch__side-body">
        <div data-lmu-list data-lmu-source="replays" data-lmu-limit="{{ section.settings.rows }}" data-lmu-skip-featured>
          <template data-lmu-template>
            <li class="aria-replay-ch__chapter">
              <a class="aria-replay-ch__chapter-btn" href="#" data-lmu-href data-lmu-play>
                <span class="aria-replay-ch__chapter-main">
                  <span class="aria-replay-ch__thumb" aria-hidden="true">
                    <span data-lmu-cover="48"></span>
                  </span>
                  <span class="aria-replay-ch__chapter-text">
                    <span class="aria-replay-ch__chapter-name" data-lmu-title></span>
                    <span class="aria-replay-ch__chapter-note" data-lmu-date="relative"></span>
                  </span>
                </span>
                <span class="aria-replay-ch__time">
                  <span data-lmu-date="day"></span>
                  <span class="aria-replay-ch__time-icon" aria-hidden="true">
                    {{- 'wp-replay-clock.svg' | inline_asset_content -}}
                  </span>
                </span>
              </a>
            </li>
          </template>
          <ol class="aria-replay-ch__chapters" role="list" data-lmu-items>
            {%- for i in (1..section.settings.rows) -%}
              <li class="aria-replay-ch__chapter aria-lmu-skeleton" data-lmu-loading aria-hidden="true" style="height: 72px;"></li>
            {%- endfor -%}
          </ol>
        </div>

        {%- if section.settings.button_label != blank -%}
          <button type="button" class="aria-replay-ch__shop-all" data-lmu-featured="replay" data-lmu-play hidden>
            {{- section.settings.button_label -}}
          </button>
        {%- endif -%}
      </div>
    </div>
  </div>
  <p data-lmu-empty>{{ section.settings.empty_text }}</p>
  <p data-lmu-error>{{ 'aria_theme.live.lmu.unavailable' | t }}</p>
</div>

{% schema %}
{
  "name": "t:sections.aria-replay-chapters.name",
  "tag": "section",
  "class": "aria-replay-ch-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.aria-replay-chapters.settings.source.content"
    },
    {
      "type": "color_background",
      "id": "background_color",
      "default": "#F5EBE2",
      "label": "t:sections.aria-replay-chapters.settings.background_color.label",
      "info": "t:sections.aria-replay-chapters.settings.background_color.info"
    },
    {
      "type": "header",
      "content": "t:sections.aria-replay-chapters.settings.copy_header.content"
    },
    {
      "type": "text",
      "id": "badge",
      "default": "Inside a replay",
      "label": "t:sections.aria-replay-chapters.settings.badge.label"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Shop straight from the replay",
      "label": "t:sections.aria-replay-chapters.settings.heading.label"
    },
    {
      "type": "text",
      "id": "text",
      "default": "Every style Kristi shows is in the player. Tap it to add it to your bag without leaving the video.",
      "label": "t:sections.aria-replay-chapters.settings.text.label"
    },
    {
      "type": "text",
      "id": "play_label",
      "default": "Play the replay",
      "label": "t:sections.aria-replay-chapters.settings.play_label.label"
    },
    {
      "type": "header",
      "content": "t:sections.aria-replay-chapters.settings.chapters_header.content"
    },
    {
      "type": "range",
      "id": "rows",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 7,
      "label": "t:sections.aria-replay-chapters.settings.rows.label"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "WATCH & SHOP THIS REPLAY",
      "label": "t:sections.aria-replay-chapters.settings.button_label.label"
    },
    {
      "type": "text",
      "id": "empty_text",
      "default": "No replays yet. Every show lands here as soon as it ends.",
      "label": "t:sections.aria-replay-chapters.settings.empty_text.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.aria-replay-chapters.presets.name"
    }
  ]
}
{% endschema %}
