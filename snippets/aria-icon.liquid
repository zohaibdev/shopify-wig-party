{%- comment -%}
  Renders a small inline line-art SVG icon used by the Aria & Co. custom sections.
  Usage: {% render 'aria-icon', name: 'search' %}
  Accepts optional `class` string appended to the wrapping svg's class attribute.
{%- endcomment -%}
{%- liquid
  assign icon_class = 'aria-icon'
  if class
    assign icon_class = icon_class | append: ' ' | append: class
  endif
-%}
{%- case name -%}
  {%- when 'search' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
      <circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.3"/>
      <path d="M11.2 11.2L14.5 14.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
    </svg>
